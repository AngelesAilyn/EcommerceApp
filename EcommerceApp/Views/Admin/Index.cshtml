@model IEnumerable<EcommerceApp.Models.Product>

@{
    ViewData["Title"] = "Administración";

    var totalProductos = (int)(ViewBag.TotalProductos ?? 0);
    var categoriasActivas = (int)(ViewBag.CategoriasActivas ?? 0);
    var productosStockBajo = (int)(ViewBag.ProductosStockBajo ?? 0);
    var productosSinStock = (int)(ViewBag.ProductosSinStock ?? 0);

    var productosDestacados = Model?
        .Where(p => !string.IsNullOrWhiteSpace(p.ImageUrl))
        .Take(4)
        .ToList()
        ?? new List<EcommerceApp.Models.Product>();
}

<style>
    .admin-home {
        width: 100%;
        min-height: calc(100vh - 70px);
        background: linear-gradient(rgba(59,36,25,.018) 1px, transparent 1px), linear-gradient(90deg, rgba(59,36,25,.018) 1px, transparent 1px), #f9f7f3;
        background-size: 32px 32px;
        color: #3b2419;
        padding: 0 0 45px;
    }

    .admin-container {
        width: 100%;
        margin: 0;
    }

    .admin-top {
        width: 100%;
        padding: 32px 5% 28px;
        background: #ffffff;
        border-bottom: 1px solid #e5dfd8;
    }

    .admin-top-inner {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
    }

    .admin-branding small {
        display: block;
        margin-bottom: 6px;
        color: #8a674f;
        font-size: .63rem;
        font-weight: 800;
        letter-spacing: .17em;
        text-transform: uppercase;
    }

    .admin-branding h1 {
        margin: 0;
        color: #3b2419;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(1.9rem, 3.6vw, 2.8rem);
        font-weight: 400;
        line-height: 1;
    }

        .admin-branding h1 span {
            color: #765039;
            font-style: italic;
        }

    .admin-branding p {
        margin: 8px 0 0;
        color: #806f62;
        font-size: .76rem;
    }

    .admin-top-action {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 11px 18px;
        background: #3b2419;
        color: #ffffff;
        text-decoration: none;
        font-size: .65rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
        transition: .25s ease;
    }

        .admin-top-action:hover {
            background: #654532;
            color: #ffffff;
            transform: translateY(-2px);
        }

    .admin-content {
        width: 100%;
        padding: 32px 5% 0;
    }

    .admin-title {
        margin-bottom: 16px;
    }

        .admin-title small {
            display: block;
            margin-bottom: 5px;
            color: #96745d;
            font-size: .6rem;
            font-weight: 800;
            letter-spacing: .16em;
            text-transform: uppercase;
        }

        .admin-title h2 {
            margin: 0;
            color: #3b2419;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 1.7rem;
            font-weight: 400;
        }

        .admin-title p {
            margin: 5px 0 0;
            color: #83766c;
            font-size: .74rem;
        }

    .admin-actions {
        display: grid;
        grid-template-columns: 1.35fr 1fr 1fr 1fr;
        gap: 10px;
        margin-bottom: 35px;
    }

    .admin-card {
        position: relative;
        min-height: 142px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        overflow: hidden;
        padding: 19px;
        color: #ffffff;
        text-decoration: none;
        border: 1px solid transparent;
        transition: .25s ease;
    }

        .admin-card:hover {
            color: #ffffff;
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(59,36,25,.13);
        }

    .admin-card-products {
        background: #3b2419;
    }

    .admin-card-inventory {
        background: #654532;
    }

    .admin-card-categories {
        background: #ffffff;
        color: #3b2419;
        border-color: #ded6ce;
    }

        .admin-card-categories:hover {
            color: #3b2419;
        }

    .admin-card-reports {
        background: #8a674f;
    }

    .admin-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .admin-card-number {
        font-family: Georgia, "Times New Roman", serif;
        font-size: .76rem;
        opacity: .58;
    }

    .admin-card-arrow {
        width: 30px;
        height: 30px;
        display: grid;
        place-items: center;
        border: 1px solid rgba(255,255,255,.3);
        font-size: .82rem;
        transition: .25s ease;
    }

    .admin-card-categories .admin-card-arrow {
        border-color: #d8cec5;
    }

    .admin-card:hover .admin-card-arrow {
        transform: translate(3px,-3px);
    }

    .admin-card h3 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.4rem;
        font-weight: 400;
    }

    .admin-card-products h3 {
        font-size: 1.75rem;
    }

    .admin-card p {
        margin: 5px 0 0;
        color: rgba(255,255,255,.7);
        font-size: .66rem;
        line-height: 1.45;
    }

    .admin-card-categories p {
        color: #817267;
    }

    .admin-card-products::after {
        content: "☕";
        position: absolute;
        right: 20px;
        bottom: -4px;
        color: rgba(255,255,255,.055);
        font-size: 5.5rem;
    }

    .admin-card-inventory::after {
        content: "✦";
        position: absolute;
        right: 18px;
        bottom: -12px;
        color: rgba(255,255,255,.06);
        font-size: 5rem;
    }

    .admin-stats-wrap {
        margin-bottom: 35px;
    }

    .admin-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        width: 100%;
        background: #ffffff;
        border: 1px solid #e1dad3;
    }

    .admin-stat {
        min-height: 100px;
        padding: 18px 21px;
        border-right: 1px solid #e5dfd8;
    }

        .admin-stat:last-child {
            border-right: none;
        }

    .admin-stat-label {
        color: #806d5e;
        font-size: .59rem;
        font-weight: 800;
        letter-spacing: .1em;
        text-transform: uppercase;
    }

    .admin-stat-value {
        margin-top: 7px;
        color: #3b2419;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 2rem;
        line-height: 1;
    }

    .admin-stat-text {
        margin-top: 5px;
        color: #9a8b80;
        font-size: .63rem;
    }

    .admin-stat-warning .admin-stat-value {
        color: #8a674f;
    }

    .admin-stat-danger .admin-stat-value {
        color: #754438;
    }

    .admin-alert {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 9px;
        padding: 13px 17px;
        background: #ffffff;
        border: 1px solid #ded5cc;
        border-left: 4px solid #654532;
    }

        .admin-alert strong {
            display: block;
            color: #4a3021;
            font-size: .73rem;
        }

        .admin-alert span {
            display: block;
            margin-top: 3px;
            color: #817267;
            font-size: .64rem;
        }

        .admin-alert a {
            color: #654532;
            text-decoration: none;
            font-size: .62rem;
            font-weight: 800;
            text-transform: uppercase;
            white-space: nowrap;
        }

    .admin-products-section {
        width: 100%;
    }

    .admin-products-header {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 16px;
    }

        .admin-products-header a {
            color: #654532;
            text-decoration: none;
            font-size: .63rem;
            font-weight: 800;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

    .admin-products-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
    }

    .admin-product {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e1dad3;
        transition: .25s ease;
    }

        .admin-product:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 23px rgba(59,36,25,.1);
        }

    .admin-product-image {
        width: 100%;
        height: 210px;
        display: block;
        object-fit: cover;
    }

    .admin-product-info {
        padding: 14px 15px 16px;
    }

    .admin-product-category {
        color: #96745d;
        font-size: .56rem;
        font-weight: 800;
        letter-spacing: .1em;
        text-transform: uppercase;
    }

    .admin-product-name {
        margin: 5px 0 9px;
        color: #432c20;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.05rem;
        font-weight: 400;
    }

    .admin-product-link {
        color: #654532;
        text-decoration: none;
        font-size: .61rem;
        font-weight: 800;
        text-transform: uppercase;
    }

        .admin-product-link:hover {
            color: #96465d;
        }

    .admin-empty {
        grid-column: 1 / -1;
        padding: 42px;
        text-align: center;
        background: #ffffff;
        border: 1px dashed #cfc7ba;
        color: #88796e;
        font-size: .76rem;
    }

    @@media (max-width: 1000px) {
        .admin-actions {
            grid-template-columns: 1fr 1fr;
        }

        .admin-card-products {
            grid-column: 1 / 3;
        }

        .admin-products-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 650px) {
        .admin-top {
            padding: 27px 5% 23px;
        }

        .admin-top-inner {
            align-items: flex-start;
            flex-direction: column;
        }

        .admin-content {
            padding: 27px 4% 0;
        }

        .admin-actions {
            grid-template-columns: 1fr 1fr;
        }

        .admin-card-products {
            grid-column: 1 / 3;
        }

        .admin-stats {
            grid-template-columns: 1fr 1fr;
        }

        .admin-stat:nth-child(2) {
            border-right: none;
        }

        .admin-stat:nth-child(-n+2) {
            border-bottom: 1px solid #e3dfd4;
        }

        .admin-alert {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    @@media (max-width: 440px) {
        .admin-actions {
            grid-template-columns: 1fr;
        }

        .admin-card-products {
            grid-column: auto;
        }

        .admin-card {
            min-height: 130px;
        }

        .admin-products-grid {
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .admin-product-image {
            height: 150px;
        }

        .admin-product-info {
            padding: 10px;
        }

        .admin-product-name {
            font-size: .92rem;
        }

        .admin-stat {
            padding: 15px;
        }

        .admin-stat-value {
            font-size: 1.75rem;
        }
    }
</style>

<div class="admin-home">

    <div class="admin-container">

        <section class="admin-top">

            <div class="admin-top-inner">

                <div class="admin-branding">

                    <small>
                        Dulce Antojo · Administración
                    </small>

                    <h1>
                        Hola, <span>bienvenida</span> ♡
                    </h1>

                    <p>
                        Todo listo para seguir haciendo crecer tu tienda.
                    </p>

                </div>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="admin-top-action">
                    Ver catálogo →
                </a>

            </div>

        </section>

        <main class="admin-content">

            <section>

                <div class="admin-title">

                    <small>
                        Espacio de trabajo
                    </small>

                    <h2>
                        ¿Qué quieres administrar?
                    </h2>

                    <p>
                        Elige una sección para comenzar.
                    </p>

                </div>

                <div class="admin-actions">

                    <a asp-controller="Products"
                       asp-action="Index"
                       class="admin-card admin-card-products">

                        <div class="admin-card-top">
                            <span class="admin-card-number">01</span>
                            <span class="admin-card-arrow">↗</span>
                        </div>

                        <div>
                            <h3>Productos</h3>
                            <p>
                                Crea, edita y administra los productos de tu catálogo.
                            </p>
                        </div>

                    </a>

                    <a asp-controller="Inventory"
                       asp-action="Index"
                       class="admin-card admin-card-inventory">

                        <div class="admin-card-top">
                            <span class="admin-card-number">02</span>
                            <span class="admin-card-arrow">↗</span>
                        </div>

                        <div>
                            <h3>Inventario</h3>
                            <p>
                                Controla existencias y disponibilidad.
                            </p>
                        </div>

                    </a>

                    <a asp-controller="Categories"
                       asp-action="Index"
                       class="admin-card admin-card-categories">

                        <div class="admin-card-top">
                            <span class="admin-card-number">03</span>
                            <span class="admin-card-arrow">↗</span>
                        </div>

                        <div>
                            <h3>Categorías</h3>
                            <p>
                                Organiza tu catálogo.
                            </p>
                        </div>

                    </a>

                    <a asp-controller="Reports"
                       asp-action="Index"
                       class="admin-card admin-card-reports">

                        <div class="admin-card-top">
                            <span class="admin-card-number">04</span>
                            <span class="admin-card-arrow">↗</span>
                        </div>

                        <div>
                            <h3>Reportes</h3>
                            <p>
                                Consulta información y resultados de tu tienda.
                            </p>
                        </div>

                    </a>

                </div>

            </section>

            <section class="admin-stats-wrap">

                <div class="admin-title">

                    <small>
                        Vista general
                    </small>

                    <h2>
                        Dulce Antojo hoy
                    </h2>

                </div>

                <div class="admin-stats">

                    <div class="admin-stat">

                        <div class="admin-stat-label">
                            Productos
                        </div>

                        <div class="admin-stat-value">
                            @totalProductos
                        </div>

                        <div class="admin-stat-text">
                            En el catálogo
                        </div>

                    </div>

                    <div class="admin-stat">

                        <div class="admin-stat-label">
                            Categorías
                        </div>

                        <div class="admin-stat-value">
                            @categoriasActivas
                        </div>

                        <div class="admin-stat-text">
                            Activas
                        </div>

                    </div>

                    <div class="admin-stat admin-stat-warning">

                        <div class="admin-stat-label">
                            Stock bajo
                        </div>

                        <div class="admin-stat-value">
                            @productosStockBajo
                        </div>

                        <div class="admin-stat-text">
                            Para revisar
                        </div>

                    </div>

                    <div class="admin-stat admin-stat-danger">

                        <div class="admin-stat-label">
                            Agotados
                        </div>

                        <div class="admin-stat-value">
                            @productosSinStock
                        </div>

                        <div class="admin-stat-text">
                            Sin disponibilidad
                        </div>

                    </div>

                </div>

                @if (productosSinStock > 0 || productosStockBajo > 0)
                {
                    <div class="admin-alert">

                        <div>

                            <strong>
                                Hay productos que necesitan atención.
                            </strong>

                            <span>
                                @productosSinStock agotados · @productosStockBajo con stock bajo
                            </span>

                        </div>

                        <a asp-controller="Inventory"
                           asp-action="Index">
                            Revisar inventario →
                        </a>

                    </div>
                }

            </section>

            <section class="admin-products-section">

                <div class="admin-products-header">

                    <div class="admin-title" style="margin-bottom:0;">

                        <small>
                            Tu vitrina
                        </small>

                        <h2>
                            Productos recientes
                        </h2>

                    </div>

                    <a asp-controller="Products"
                       asp-action="Index">
                        Ver todos →
                    </a>

                </div>

                <div class="admin-products-grid">

                    @if (productosDestacados.Any())
                    {
                        foreach (var producto in productosDestacados)
                        {
                            <article class="admin-product">

                                <img src="@producto.ImageUrl"
                                     alt="@producto.Name"
                                     class="admin-product-image" />

                                <div class="admin-product-info">

                                    <div class="admin-product-category">
                                        @producto.Category
                                    </div>

                                    <h3 class="admin-product-name">
                                        @producto.Name
                                    </h3>

                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@producto.Id"
                                       class="admin-product-link">
                                        Ver producto →
                                    </a>

                                </div>

                            </article>
                        }
                    }
                    else
                    {
                        <div class="admin-empty">
                            Todavía no tienes productos con imágenes para mostrar.
                        </div>
                    }

                </div>

            </section>

        </main>

    </div>

</div>