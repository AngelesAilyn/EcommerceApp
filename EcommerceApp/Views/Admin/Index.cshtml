@model IEnumerable<EcommerceApp.Models.Product>

@{
    ViewData["Title"] = "Panel administrativo";

    var totalProductos = (int)(ViewBag.TotalProductos ?? 0);
    var categoriasActivas = (int)(ViewBag.CategoriasActivas ?? 0);
    var productosStockBajo = (int)(ViewBag.ProductosStockBajo ?? 0);
    var productosSinStock = (int)(ViewBag.ProductosSinStock ?? 0);

    var productosDestacados = Model?
        .Where(p => !string.IsNullOrWhiteSpace(p.ImageUrl))
        .Take(4)
        .ToList()
        ?? new List<EcommerceApp.Models.Product>();
}
<style>
    .admin-page {
        width: 100%;
        min-height: calc(100vh - 70px);
        background: #f5eee6;
        color: #3d2a20;
        padding-bottom: 60px;
        overflow-x: hidden;
    }

    .admin-hero {
        width: 100%;
        min-height: 390px;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
        background: linear-gradient(90deg, rgba(61,42,32,.88) 0%, rgba(61,42,32,.72) 42%, rgba(61,42,32,.20) 100%), url('https://static.vecteezy.com/system/resources/thumbnails/042/392/323/small_2x/ai-generated-different-fruit-cakes-on-a-wooden-table-top-view-photo.jpg') center/cover;
    }

        .admin-hero::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, transparent 65%, rgba(61,42,32,.25));
            pointer-events: none;
        }

    .admin-hero-content {
        position: relative;
        z-index: 2;
        width: min(1180px, 90%);
        margin: 0 auto;
        padding: 55px 0;
    }

    .admin-eyebrow {
        display: inline-block;
        margin-bottom: 18px;
        color: #ead8c5;
        font-size: .68rem;
        font-weight: 800;
        letter-spacing: .18em;
        text-transform: uppercase;
    }

    .admin-hero h1 {
        max-width: 650px;
        margin: 0;
        color: #fffaf5;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2.8rem, 6vw, 5.5rem);
        font-weight: 400;
        line-height: .95;
        letter-spacing: -.035em;
    }

    .admin-hero p {
        max-width: 520px;
        margin: 22px 0 0;
        color: rgba(255,250,245,.82);
        font-size: .95rem;
        line-height: 1.7;
    }

    .admin-content {
        width: min(1180px, 90%);
        margin: 0 auto;
    }

    .admin-shortcuts {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0;
        margin: 28px 0 0;
        padding: 0;
        background: transparent;
        border: none;
        box-shadow: none;
    }

    .admin-shortcut {
        min-width: 0;
        min-height: 160px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 25px 23px;
        background: #fffaf4;
        color: #3d2a20;
        text-decoration: none;
        border-top: 1px solid #e1d6ca;
        border-bottom: 1px solid #e1d6ca;
        border-right: 1px solid #e1d6ca;
        transition: transform .25s ease, background .25s ease, box-shadow .25s ease;
    }

        .admin-shortcut:first-child {
            border-left: 1px solid #e1d6ca;
            border-radius: 16px 0 0 16px;
        }

        .admin-shortcut:last-child {
            border-radius: 0 16px 16px 0;
        }

        .admin-shortcut:hover {
            background: #f1e5d8;
            color: #3d2a20;
            transform: translateY(-3px);
            box-shadow: 0 10px 24px rgba(61,42,32,.10);
            position: relative;
            z-index: 3;
        }

        .admin-shortcut i {
            width: 43px;
            height: 43px;
            display: grid;
            place-items: center;
            margin-bottom: 17px;
            border-radius: 50%;
            background: #eadccd;
            color: #684936;
            font-size: 1rem;
        }

        .admin-shortcut h3 {
            margin: 0;
            color: #3d2a20;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 1.25rem;
            font-weight: 400;
        }

        .admin-shortcut span {
            display: block;
            margin-top: 7px;
            color: #8b796b;
            font-size: .67rem;
            line-height: 1.4;
        }

    .admin-section {
        padding-top: 42px;
    }

    .admin-section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 20px;
    }

        .admin-section-heading small {
            display: block;
            margin-bottom: 7px;
            color: #98765d;
            font-size: .62rem;
            font-weight: 800;
            letter-spacing: .16em;
            text-transform: uppercase;
        }

        .admin-section-heading h2 {
            margin: 0;
            color: #3d2a20;
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(1.8rem, 3vw, 2.5rem);
            font-weight: 400;
            line-height: 1;
        }

        .admin-section-heading p {
            margin: 8px 0 0;
            color: #8b796b;
            font-size: .74rem;
        }

        .admin-section-heading a {
            color: #654532;
            text-decoration: none;
            font-size: .65rem;
            font-weight: 800;
            letter-spacing: .07em;
            text-transform: uppercase;
            white-space: nowrap;
        }

    .admin-metrics {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
    }

    .metric-card {
        min-width: 0;
        min-height: 145px;
        padding: 24px;
        background: #fffdf9;
        border: 1px solid #e2d9cf;
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .metric-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(61,42,32,.08);
        }

    .metric-label {
        display: block;
        color: #89786b;
        font-size: .61rem;
        font-weight: 800;
        letter-spacing: .1em;
        text-transform: uppercase;
    }

    .metric-value {
        display: block;
        margin-top: 15px;
        color: #3d2a20;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 2.65rem;
        font-weight: 400;
        line-height: 1;
    }

    .metric-card:nth-child(3) .metric-value {
        color: #9a7252;
    }

    .metric-card:nth-child(4) .metric-value {
        color: #875847;
    }

    .admin-alert {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        margin-top: 13px;
        padding: 19px 22px;
        background: #eee3d6;
        border-left: 4px solid #745039;
    }

        .admin-alert strong {
            display: block;
            color: #4a3022;
            font-size: .75rem;
        }

        .admin-alert span {
            display: block;
            margin-top: 4px;
            color: #806e61;
            font-size: .67rem;
        }

        .admin-alert a {
            color: #5e402e;
            text-decoration: none;
            font-size: .62rem;
            font-weight: 800;
            letter-spacing: .05em;
            text-transform: uppercase;
            white-space: nowrap;
        }

    .admin-products {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
    }

    .admin-product {
        min-width: 0;
        overflow: hidden;
        background: #fffdf9;
        border: 1px solid #e2d9cf;
        transition: transform .28s ease, box-shadow .28s ease;
    }

        .admin-product:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 30px rgba(61,42,32,.10);
        }

    .admin-product-image {
        width: 100%;
        height: 245px;
        display: block;
        object-fit: cover;
    }

    .admin-product-info {
        padding: 17px 18px 20px;
    }

    .admin-product-category {
        color: #9a765d;
        font-size: .57rem;
        font-weight: 800;
        letter-spacing: .11em;
        text-transform: uppercase;
    }

    .admin-product-name {
        margin: 7px 0 12px;
        color: #432c20;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.18rem;
        font-weight: 400;
    }

    .admin-product-link {
        color: #654532;
        text-decoration: none;
        font-size: .61rem;
        font-weight: 800;
        letter-spacing: .05em;
        text-transform: uppercase;
    }

        .admin-product-link:hover {
            color: #93604b;
        }

    .admin-empty {
        grid-column: 1 / -1;
        padding: 55px 20px;
        text-align: center;
        background: #fffdf9;
        border: 1px dashed #cfc3b6;
        color: #89796d;
        font-size: .75rem;
    }

    @@media (max-width: 1050px) {
        .admin-shortcuts {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .admin-shortcut:nth-child(3) {
            border-right: 1px solid #e1d6ca;
        }

        .admin-shortcut:nth-child(4) {
            border-left: 1px solid #e1d6ca;
            border-top: none;
            border-radius: 0 0 0 16px;
        }

        .admin-shortcut:nth-child(5) {
            border-top: none;
            border-radius: 0 0 16px 0;
        }

        .admin-metrics {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .admin-products {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 700px) {
        .admin-hero {
            min-height: 340px;
        }

        .admin-hero-content {
            width: 88%;
            padding: 45px 0;
        }

        .admin-hero h1 {
            font-size: clamp(2.7rem, 12vw, 4rem);
        }

        .admin-hero p {
            font-size: .84rem;
            max-width: 430px;
        }

        .admin-content {
            width: 90%;
        }

        .admin-shortcuts {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            margin-top: 24px;
        }

        .admin-shortcut {
            min-height: 145px;
            padding: 20px;
        }

            .admin-shortcut:first-child {
                border-radius: 16px 0 0 0;
            }

            .admin-shortcut:nth-child(2) {
                border-radius: 0 16px 0 0;
            }

            .admin-shortcut:nth-child(3) {
                border-left: 1px solid #e1d6ca;
                border-radius: 0;
            }

            .admin-shortcut:nth-child(4) {
                border-left: none;
                border-radius: 0;
            }

            .admin-shortcut:nth-child(5) {
                grid-column: 1 / 3;
                border-left: 1px solid #e1d6ca;
                border-top: 1px solid #e1d6ca;
                border-radius: 0 0 16px 16px;
            }

        .admin-section {
            padding-top: 38px;
        }
    }

    @@media (max-width: 480px) {
        .admin-page {
            padding-bottom: 45px;
        }

        .admin-content {
            width: 92%;
        }

        .admin-hero {
            min-height: 310px;
        }

        .admin-hero-content {
            width: 92%;
            padding: 40px 0;
        }

        .admin-hero h1 {
            font-size: clamp(2.35rem, 13vw, 3.5rem);
        }

        .admin-hero p {
            margin-top: 17px;
            font-size: .8rem;
            line-height: 1.55;
        }

        .admin-shortcuts {
            grid-template-columns: 1fr 1fr;
            margin-top: 18px;
        }

        .admin-shortcut {
            min-height: 130px;
            padding: 16px;
        }

            .admin-shortcut i {
                width: 36px;
                height: 36px;
                margin-bottom: 13px;
                font-size: .9rem;
            }

            .admin-shortcut h3 {
                font-size: 1rem;
            }

            .admin-shortcut span {
                font-size: .6rem;
            }

        .admin-metrics {
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .metric-card {
            min-height: 120px;
            padding: 16px;
        }

        .metric-value {
            font-size: 2rem;
        }

        .admin-products {
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .admin-product-image {
            height: 165px;
        }

        .admin-product-info {
            padding: 12px;
        }

        .admin-product-name {
            font-size: .98rem;
        }

        .admin-section-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .admin-alert {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<div class="admin-page">

    <section class="admin-hero">
        <div class="admin-hero-content">

            <span class="admin-eyebrow">
                Panel de administración
            </span>

            <h1>
                Bienvenida a<br />
                Dulce Antojo.
            </h1>

            <p>
                Gestiona tu catálogo, inventario, pedidos y reportes
                desde un solo lugar.
            </p>

        </div>
    </section>

    <div class="admin-content">

        <section class="admin-shortcuts">

            <a class="admin-shortcut"
               asp-controller="Products"
               asp-action="Index">

                <i class="bi bi-box-seam"></i>

                <h3>
                    Productos
                </h3>

                <span>
                    Catálogo y disponibilidad
                </span>

            </a>

            <a class="admin-shortcut"
               asp-controller="Categories"
               asp-action="Index">

                <i class="bi bi-grid"></i>

                <h3>
                    Categorías
                </h3>

                <span>
                    Organiza tu catálogo
                </span>

            </a>

            <a class="admin-shortcut"
               asp-controller="Inventory"
               asp-action="Index">

                <i class="bi bi-clipboard-data"></i>

                <h3>
                    Inventario
                </h3>

                <span>
                    Control de existencias
                </span>

            </a>

            <a class="admin-shortcut"
               asp-controller="Admin"
               asp-action="Orders">

                <i class="bi bi-receipt"></i>

                <h3>
                    Pedidos
                </h3>

                <span>
                    Gestiona las compras
                </span>

            </a>

            <a class="admin-shortcut"
               asp-controller="Reports"
               asp-action="Index">

                <i class="bi bi-bar-chart-line"></i>

                <h3>
                    Reportes
                </h3>

                <span>
                    Ventas y estadísticas
                </span>

            </a>

        </section>

        <section class="admin-section">

            <div class="admin-section-heading">

                <div>

                    <small>
                        Vista general
                    </small>

                    <h2>
                        Dulce Antojo hoy
                    </h2>

                    <p>
                        Consulta rápidamente el estado de tu tienda.
                    </p>

                </div>

            </div>

            <div class="admin-metrics">

                <div class="metric-card">

                    <span class="metric-label">
                        Productos activos
                    </span>

                    <span class="metric-value">
                        @totalProductos
                    </span>

                </div>

                <div class="metric-card">

                    <span class="metric-label">
                        Categorías activas
                    </span>

                    <span class="metric-value">
                        @categoriasActivas
                    </span>

                </div>

                <div class="metric-card">

                    <span class="metric-label">
                        Stock bajo
                    </span>

                    <span class="metric-value">
                        @productosStockBajo
                    </span>

                </div>

                <div class="metric-card">

                    <span class="metric-label">
                        Sin stock
                    </span>

                    <span class="metric-value">
                        @productosSinStock
                    </span>

                </div>

            </div>

            @if (productosSinStock > 0 || productosStockBajo > 0)
            {
                <div class="admin-alert">

                    <div>

                        <strong>
                            Hay productos que necesitan atención.
                        </strong>

                        <span>
                            @productosSinStock agotados ·
                            @productosStockBajo con stock bajo
                        </span>

                    </div>

                    <a asp-controller="Inventory"
                       asp-action="Index">
                        Revisar inventario →
                    </a>

                </div>
            }

        </section>

        <section class="admin-section">

            <div class="admin-section-heading">

                <div>

                    <small>
                        Tu vitrina
                    </small>

                    <h2>
                        Productos recientes
                    </h2>

                    <p>
                        Una vista rápida de los productos de tu catálogo.
                    </p>

                </div>

                <a asp-controller="Products"
                   asp-action="Index">
                    Ver todos →
                </a>

            </div>

            <div class="admin-products">

                @if (productosDestacados.Any())
                {
                    foreach (var producto in productosDestacados)
                    {
                        <article class="admin-product">

                            <img src="@producto.ImageUrl"
                                 alt="@producto.Name"
                                 class="admin-product-image" />

                            <div class="admin-product-info">

                                <div class="admin-product-category">
                                    @producto.Category
                                </div>

                                <h3 class="admin-product-name">
                                    @producto.Name
                                </h3>

                                <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@producto.Id"
                                   class="admin-product-link">
                                    Ver producto →
                                </a>

                            </div>

                        </article>
                    }
                }
                else
                {
                    <div class="admin-empty">
                        Todavía no tienes productos con imágenes para mostrar.
                    </div>
                }

            </div>

        </section>

    </div>

</div>