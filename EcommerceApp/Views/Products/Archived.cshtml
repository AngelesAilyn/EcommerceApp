@model IEnumerable<EcommerceApp.Models.Product>

@{
    ViewData["Title"] = "Productos archivados";
}

<style>

    .archived-page {
        min-height: 100vh;
        padding: 55px 35px 90px;
        background-color: #f3eadf;
        background-image: radial-gradient(circle at 20px 20px, rgba(116, 77, 51, 0.08) 2px, transparent 2.5px), radial-gradient(circle at 60px 60px, rgba(116, 77, 51, 0.06) 2px, transparent 2.5px);
        background-size: 80px 80px;
    }

    .archived-container {
        max-width: 1150px;
        margin: 0 auto;
    }

    .archived-header {
        text-align: center;
        margin-bottom: 45px;
    }

    .archived-label {
        display: block;
        margin-bottom: 10px;
        color: #8b5e3c;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 4px;
        text-transform: uppercase;
    }

    .archived-header h1 {
        margin: 0;
        color: #35241b;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 46px;
        line-height: 1.1;
        font-weight: 700;
    }

    .archived-header p {
        max-width: 620px;
        margin: 15px auto 22px;
        color: #756456;
        font-size: 15px;
        line-height: 1.7;
    }

    .back-products {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 18px;
        border-radius: 10px;
        background: #4a3426;
        color: white;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: .2s ease;
    }

        .back-products:hover {
            background: #6f513b;
            color: white;
            transform: translateY(-1px);
        }

    .archived-divider {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 28px;
    }

        .archived-divider::before,
        .archived-divider::after {
            content: "";
            height: 1px;
            flex: 1;
            background: #d4bda6;
        }

        .archived-divider span {
            color: #8b6a4e;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

    .archived-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
    }

    .archived-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid #e4d5c5;
        border-radius: 18px;
        background: #fffdf9;
        box-shadow: 0 7px 22px rgba(73, 51, 40, 0.10);
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .archived-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(73, 51, 40, 0.16);
        }

    .archived-image {
        position: relative;
        width: 100%;
        height: 190px;
        overflow: hidden;
        background: #e9d9c7;
    }

        .archived-image img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            filter: saturate(.85);
            transition: transform .5s ease;
        }

    .archived-card:hover .archived-image img {
        transform: scale(1.05);
    }

    .archived-status {
        position: absolute;
        top: 13px;
        right: 13px;
        padding: 7px 11px;
        border-radius: 20px;
        background: #6f513b;
        color: white;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .5px;
    }

    .archived-info {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 20px;
    }

        .archived-info h2 {
            margin: 0 0 8px;
            color: #3d2a20;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 21px;
            font-weight: 700;
        }

    .archived-description {
        display: -webkit-box;
        overflow: hidden;
        margin: 0 0 18px;
        color: #786960;
        font-size: 13px;
        line-height: 1.55;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
    }

    .archived-details {
        padding: 13px 0;
        margin-bottom: 18px;
        border-top: 1px solid #eee2d5;
        border-bottom: 1px solid #eee2d5;
    }

        .archived-details p {
            margin: 5px 0;
            color: #756657;
            font-size: 13px;
        }

        .archived-details strong {
            color: #4a3426;
        }

    .archived-price {
        color: #8b5e3c;
        font-size: 18px;
        font-weight: 700;
    }

    .archived-stock {
        color: #756456;
        font-size: 12px;
    }

    .archived-actions {
        margin-top: auto;
    }

    .btn-unarchive {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        width: 100%;
        padding: 10px 15px;
        border-radius: 9px;
        background: #8b6a4e;
        color: white !important;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: .2s ease;
    }

        .btn-unarchive:hover {
            background: #6f513b;
            color: white !important;
            transform: translateY(-1px);
        }

    .archived-empty {
        max-width: 600px;
        margin: 20px auto 0;
        padding: 55px 30px;
        text-align: center;
        border: 1px solid #e2d3c2;
        border-radius: 20px;
        background: #fffdf9;
        box-shadow: 0 7px 22px rgba(73, 51, 40, 0.08);
    }

    .archived-empty-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #eee3d6;
        color: #8b6a4e;
        font-size: 24px;
    }

    .archived-empty h2 {
        margin: 0 0 10px;
        color: #3d2a20;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 25px;
    }

    .archived-empty p {
        margin: 0;
        color: #786960;
        font-size: 14px;
    }

    @@media (max-width: 900px) {

        .archived-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {

        .archived-page {
            padding: 40px 18px 65px;
        }

        .archived-header h1 {
            font-size: 37px;
        }

        .archived-header p {
            font-size: 14px;
        }

        .archived-grid {
            grid-template-columns: 1fr;
        }

        .archived-image {
            height: 220px;
        }
    }

</style>

<div class="archived-page">

    <div class="archived-container">

        <div class="archived-header">

            <span class="archived-label">
                Dulce Antojo
            </span>

            <h1>
                Productos archivados
            </h1>

            <p>
                Consulta los productos que ya no aparecen
                en el catálogo y recupera aquellos que quieras
                volver a ofrecer.
            </p>

            <a asp-action="Index"
               class="back-products">
                <i class="bi bi-arrow-left"></i>
                Volver a productos
            </a>

        </div>

        @if (!Model.Any())
        {
            <div class="archived-empty">

                <div class="archived-empty-icon">
                    <i class="bi bi-archive"></i>
                </div>

                <h2>
                    No hay productos archivados
                </h2>

                <p>
                    Los productos que archives aparecerán aquí
                    para que puedas recuperarlos posteriormente.
                </p>

            </div>
        }
        else
        {
            <div class="archived-divider">

                <span>
                    Productos guardados
                </span>

            </div>

            <div class="archived-grid">

                @foreach (var product in Model)
                {
                    <article class="archived-card">

                        <div class="archived-image">

                            @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl"
                                     alt="@product.Name" />
                            }
                            else
                            {
                                <div style="
                                    width:100%;
                                    height:100%;
                                    display:flex;
                                    align-items:center;
                                    justify-content:center;
                                    color:#8b7869;
                                    font-size:13px;">
                                    Sin imagen
                                </div>
                            }

                            <span class="archived-status">
                                ARCHIVADO
                            </span>

                        </div>

                        <div class="archived-info">

                            <h2>
                                @product.Name
                            </h2>

                            <p class="archived-description">
                                @product.Description
                            </p>

                            <div class="archived-details">

                                <p>
                                    <strong>Precio:</strong>
                                    <span class="archived-price">
                                        Bs. @product.Price.ToString("0.00")
                                    </span>
                                </p>

                                <p>
                                    <strong>Stock:</strong>
                                    <span class="archived-stock">
                                        @product.Stock unidades
                                    </span>
                                </p>

                            </div>

                            <div class="archived-actions">

                                <a asp-action="Unarchive"
                                   asp-route-id="@product.Id"
                                   class="btn-unarchive">

                                    <i class="bi bi-arrow-counterclockwise"></i>

                                    Desarchivar

                                </a>

                            </div>

                        </div>

                    </article>
                }

            </div>
        }

    </div>

</div>