@model IEnumerable<EcommerceApp.Models.Product>

@{
    ViewData["Title"] = "Productos";

    var selectedCategory = ViewBag.SelectedCategory?.ToString();

    var categories = ((IEnumerable<string>)ViewBag.Categories)
        .Where(c => !string.IsNullOrWhiteSpace(c))
        .ToList();
}

<style>

    .products-page {
        min-height: 100vh;
        background: #f5efe6;
        color: #3e2b21;
        padding-bottom: 0;
    }


    .products-hero {
        min-height: 150px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eadcc9;
        border-bottom: 1px solid #d4c2ad;
    }


    .products-hero-content {
        width: 100%;
        text-align: center;
        padding: 22px 20px;
    }


    .products-hero-small {
        margin-bottom: 10px;
        color: #9a6c50;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 3px;
        text-transform: uppercase;
    }


    .products-hero h1 {
        margin: 0;
        color: #3d2a21;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(36px, 5vw, 52px);
        font-weight: 400;
        line-height: 1;
        letter-spacing: -1px;
    }


    .products-content {
        width: 100%;
        margin: 0 auto;
        padding: 25px 0 0;
    }


    .products-heading {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 0;
    }


    .admin-buttons {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }


        .admin-buttons a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 11px 17px;
            border: 1px solid #573c2d;
            border-radius: 2px;
            background: #573c2d;
            color: white;
            text-decoration: none;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
            transition: all .25s ease;
        }


            .admin-buttons a:hover {
                background: #9a694e;
                border-color: #9a694e;
                transform: translateY(-2px);
            }


        .admin-buttons .archived {
            background: transparent;
            color: #745543;
            border-color: #b89b84;
        }


            .admin-buttons .archived:hover {
                background: #b89b84;
                color: white;
            }


    .category-navigation {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
        padding: 10px 18px 23px;
    }


        .category-navigation a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 11px 20px;
            border: 1px solid #cdbbaa;
            border-radius: 2px;
            background: #fffaf3;
            color: #634939;
            text-decoration: none;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
            transition: all .25s ease;
        }


            .category-navigation a:hover {
                background: #8f6249;
                border-color: #8f6249;
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 6px 12px rgba(80, 52, 38, .12);
            }


            .category-navigation a.active {
                background: #4d3427;
                border-color: #4d3427;
                color: white;
            }


    
    .category-section {
        margin-bottom: 0;
        padding: 42px 38px 45px;
        
        scroll-margin-top: 85px;
    }


        .category-section.category-chocolate {
            background: #d8c1ad;
        }


        .category-section.category-caramel {
            background: #e8d0a8;
        }


        .category-section.category-beige {
            background: #eee4d2;
        }


        .category-section.category-salvia {
            background: #d7ded2;
        }


        .category-section.category-rosa {
            background: #e6ceca;
        }


        .category-section.category-terracota {
            background: #dfc0ad;
        }


    .category-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        padding-bottom: 20px;
        margin-bottom: 30px;
        border-bottom: 1px solid rgba(67, 46, 34, .25);
    }


    .category-title-area {
        display: flex;
        align-items: baseline;
        gap: 15px;
    }


    .category-number {
        color: rgba(73, 49, 36, .55);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 18px;
        font-style: italic;
    }


    .category-header h2 {
        margin: 0;
        color: #3b2920;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(32px, 4vw, 48px);
        font-weight: 400;
        line-height: 1;
    }


    .category-count {
        color: #705848;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
    }


    .products-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 22px;
    }


    .product-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
        background: #fffaf4;
        border: none;
        border-radius: 0;
        box-shadow: 0 7px 20px rgba(62, 42, 30, .10);
        transition: transform .3s ease, box-shadow .3s ease;
    }


        .product-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 16px 30px rgba(62, 42, 30, .17);
        }


    .product-image {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background: #e3d6c7;
    }


        .product-image img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            transition: transform .6s ease;
        }


    .product-card:hover .product-image img {
        transform: scale(1.06);
    }


    .product-status {
        position: absolute;
        top: 14px;
        left: 14px;
        padding: 7px 10px;
        background: rgba(255, 250, 244, .94);
        color: #634635;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
    }


        .product-status.out {
            background: #4a3428;
            color: white;
        }


    .product-info {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 22px 20px 20px;
    }


    .product-category {
        margin-bottom: 8px;
        color: #a16f52;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1.7px;
        text-transform: uppercase;
    }


    .product-info h3 {
        margin: 0;
        color: #3d2b21;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 22px;
        font-weight: 400;
        line-height: 1.2;
    }


    .product-description {
        display: -webkit-box;
        overflow: hidden;
        min-height: 42px;
        margin: 10px 0 22px;
        color: #806d60;
        font-size: 12px;
        line-height: 1.7;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }


    .product-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-top: auto;
    }


    .product-price {
        color: #633f2c;
        font-size: 19px;
        font-weight: 800;
        white-space: nowrap;
    }


    .product-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-width: 110px;
        padding: 11px 15px;
        border: none;
        border-radius: 2px;
        background: #633f2c;
        color: white !important;
        text-decoration: none;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
        transition: all .25s ease;
    }


        .product-button:hover {
            background: #b47755;
            color: white !important;
            transform: translateY(-2px);
            box-shadow: 0 7px 15px rgba(82, 50, 34, .20);
        }


    .product-arrow {
        font-size: 15px;
        line-height: 1;
        transition: transform .25s ease;
    }


    .product-button:hover .product-arrow {
        transform: translateX(4px);
    }


    .unavailable {
        padding: 9px 11px;
        background: #e6ddd3;
        color: #806f63;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
    }


    .admin-actions {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
        padding-top: 13px;
        margin-top: 15px;
        border-top: 1px solid rgba(80, 55, 41, .15);
    }


        .admin-actions a {
            padding: 6px 9px;
            border-radius: 2px;
            text-decoration: none;
            font-size: 8px;
            font-weight: 800;
            letter-spacing: .5px;
            text-transform: uppercase;
            transition: all .2s ease;
        }


    .edit-button {
        background: #e6ddd2;
        color: #604a3b !important;
    }


        .edit-button:hover {
            background: #d4c5b7;
        }


    .archive-button {
        background: #a97a5c;
        color: white !important;
    }


        .archive-button:hover {
            background: #8d6048;
        }


    .delete-button {
        background: #e3cfca;
        color: #774d45 !important;
    }


        .delete-button:hover {
            background: #d3b7b0;
        }


    .empty-products {
        max-width: 650px;
        margin: 20px auto 70px;
        padding: 75px 30px;
        text-align: center;
        background: #fffaf4;
    }


        .empty-products h3 {
            margin: 0 0 12px;
            color: #3d2b21;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 32px;
            font-weight: 400;
        }


        .empty-products p {
            margin: 0;
            color: #806d60;
            font-size: 14px;
        }


    @@media (max-width: 1100px) {

        .products-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }


    @@media (max-width: 850px) {

        .products-hero {
            min-height: 180px;
        }

        .products-content {
            padding: 45px 22px 0;
        }

        .products-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .products-heading {
            justify-content: center;
        }
    }


    @@media (max-width: 560px) {

        .products-hero {
            min-height: 165px;
        }

        .products-hero-content {
            padding: 28px 15px;
        }

        .products-hero h1 {
            font-size: 42px;
        }

        .products-hero-small {
            font-size: 9px;
            letter-spacing: 2px;
        }

        .products-content {
            padding: 35px 15px 0;
        }

        .admin-buttons {
            width: 100%;
        }

            .admin-buttons a {
                flex: 1;
            }

        .category-navigation {
            justify-content: flex-start;
            flex-wrap: nowrap;
            overflow-x: auto;
            padding-bottom: 35px;
            scrollbar-width: none;
        }

            .category-navigation::-webkit-scrollbar {
                display: none;
            }

            .category-navigation a {
                flex: 0 0 auto;
                white-space: nowrap;
            }

        .category-section {
            padding: 28px 18px 30px;
        }

        .category-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 8px;
        }

        .category-title-area {
            gap: 11px;
        }

        .category-header h2 {
            font-size: 34px;
        }

        .products-grid {
            grid-template-columns: 1fr;
        }

        .product-image {
            aspect-ratio: 1 / .88;
        }
    }

</style>


<div class="products-page">

    <section class="products-hero">

        <div class="products-hero-content">

            <div class="products-hero-small">
                Dulce Antojo · Repostería artesanal
            </div>

            <h1>
                Nuestros Productos
            </h1>

        </div>

    </section>


    <main class="products-content">

        <div class="products-heading">

            @if (User.IsInRole("Admin"))
            {
                <div class="admin-buttons">

                    <a asp-action="Create">
                        + Nuevo producto
                    </a>

                    <a asp-action="Archived"
                       class="archived">

                        <i class="bi bi-archive"></i>
                        Archivados

                    </a>

                </div>
            }

        </div>


        <nav class="category-navigation">

            <!-- TODOS -->
            <a asp-action="Index"
               class="@(string.IsNullOrWhiteSpace(selectedCategory) ? "active" : "")">

                Todos

            </a>


            <!-- CATEGORÍAS -->
            @foreach (var category in categories)
            {
                var categoryId = category
                .Trim()
                .ToLower()
                .Replace(" ", "-");

                <a href="@Url.Action("Index", new { category = category })#categoria-@categoryId"
                   class="@(selectedCategory == category ? "active" : "")">

                    @category

                </a>
            }

        </nav>


        @if (Model.Any())
        {
            var productosPorCategoria = Model
            .GroupBy(p => p.CategoryNavigation?.Name ?? p.Category ?? "Otros productos")
            .OrderBy(g => g.Key);

            var categoryNumber = 1;

            foreach (var grupo in productosPorCategoria)
            {
                var categoryClass = categoryNumber switch
                {
                    1 => "category-chocolate",
                    2 => "category-caramel",
                    3 => "category-beige",
                    4 => "category-salvia",
                    5 => "category-rosa",
                    _ => "category-terracota"
                };

                var categoryId = grupo.Key
                .Trim()
                .ToLower()
                .Replace(" ", "-");

                <section id="categoria-@categoryId"
                         class="category-section @categoryClass">

                    <div class="category-header">

                        <div class="category-title-area">

                            <span class="category-number">
                                @(categoryNumber.ToString("00"))
                            </span>

                            <h2>
                                @grupo.Key
                            </h2>

                        </div>

                        <span class="category-count">

                            @grupo.Count()

                            @(grupo.Count() == 1
                                                ? "producto"
                                                : "productos")

                        </span>

                    </div>


                    <div class="products-grid">

                        @foreach (var product in grupo)
                        {
                            <article class="product-card">

                                <div class="product-image">

                                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl"
                                             alt="@product.Name" />
                                    }
                                    else
                                    {
                                        <div style="
                                            width:100%;
                                            height:100%;
                                            display:flex;
                                            align-items:center;
                                            justify-content:center;
                                            color:#806d60;
                                            font-size:13px;">

                                            Sin imagen

                                        </div>
                                    }


                                    @if (product.Stock <= 0)
                                    {
                                        <span class="product-status out">
                                            Agotado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="product-status">
                                            Disponible
                                        </span>
                                    }

                                </div>


                                <div class="product-info">

                                    <span class="product-category">
                                        @grupo.Key
                                    </span>

                                    <h3>
                                        @product.Name
                                    </h3>

                                    <p class="product-description">
                                        @product.Description
                                    </p>


                                    <div class="product-bottom">

                                        <span class="product-price">
                                            Bs. @product.Price.ToString("0.00")
                                        </span>


                                        @if (product.Stock > 0)
                                        {
                                            <a asp-action="Details"
                                               asp-route-id="@product.Id"
                                               class="product-button">

                                                <span>
                                                    Detalles
                                                </span>

                                                <span class="product-arrow">
                                                    →
                                                </span>

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="unavailable">
                                                Agotado
                                            </span>
                                        }

                                    </div>


                                    @if (User.IsInRole("Admin"))
                                    {
                                        <div class="admin-actions">

                                            <a asp-action="Edit"
                                               asp-route-id="@product.Id"
                                               class="edit-button">

                                                Editar

                                            </a>

                                            <a asp-action="Archive"
                                               asp-route-id="@product.Id"
                                               class="archive-button">

                                                <i class="bi bi-archive"></i>
                                                Archivar

                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@product.Id"
                                               class="delete-button">

                                                Eliminar

                                            </a>

                                        </div>
                                    }

                                </div>

                            </article>
                        }

                    </div>

                </section>

                categoryNumber++;
            }
        }
        else
        {
            <div class="empty-products">

                <h3>
                    No hay productos disponibles
                </h3>

                <p>
                    En este momento no tenemos productos para mostrar en esta categoría.
                </p>

            </div>
        }

    </main>

</div>