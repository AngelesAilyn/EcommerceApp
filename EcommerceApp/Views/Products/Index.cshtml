@model IEnumerable<EcommerceApp.Models.Product>

@{
    ViewData["Title"] = "Productos";

    var selectedCategory = ViewBag.SelectedCategory?.ToString();

    var categories = ((IEnumerable<string>)ViewBag.Categories)
        .Where(c => !string.IsNullOrWhiteSpace(c))
        .ToList();
}

<style>

    .products-hero {
        background-image: linear-gradient( to top, rgba(39, 25, 17, 0.82) 0%, rgba(39, 25, 17, 0.22) 45%, rgba(39, 25, 17, 0) 72%), url("https://img.freepik.com/premium-photo/fresh-various-desserts-seamless-background_1103100-1303.jpg");
        border-bottom: 1px solid #e6d9ca;
    }

    .products-hero-content {
        padding: 55px 20px 50px;
        text-align: center;
    }

    .products-hero-small {
        margin-bottom: 12px;
        color: #ffffff;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
    }

    .products-hero h1 {
        margin: 0;
        color: #ffffff;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(40px, 5vw, 58px);
        font-weight: 400;
        letter-spacing: -1px;
    }


    .products-content {
        width: 100%;
        margin: 0 auto;
        padding: 35px 34px 70px;
    }

    .products-heading {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 20px;
    }

    .admin-buttons {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
    }

        .admin-buttons a {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 10px 16px;
            border-radius: 999px;
            background: #654633;
            color: #fff !important;
            text-decoration: none;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .8px;
            text-transform: uppercase;
            transition: all .25s ease;
        }

            .admin-buttons a:hover {
                background: #4a3426;
                transform: translateY(-2px);
            }

        .admin-buttons .archived {
            background: #e8ddd1;
            color: #604838 !important;
        }

            .admin-buttons .archived:hover {
                background: #d8c8b8;
            }

    .category-navigation {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        margin-bottom: 38px;
    }

        .category-navigation a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 10px 19px;
            border: 1px solid #d9c9b8;
            border-radius: 999px;
            background: #fffaf4;
            color: #684b3a;
            text-decoration: none;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .8px;
            text-transform: uppercase;
            transition: all .25s ease;
        }

            .category-navigation a:hover {
                background: #eadfd3;
                border-color: #cdb9a5;
                transform: translateY(-2px);
            }

            .category-navigation a.active {
                background: #5b3d2c;
                border-color: #5b3d2c;
                color: #fff;
            }

    .category-section.category-chocolate {
        background: #b88b5c;
    }

    .category-section.category-caramel {
        background: #f0c095;
    }

    .category-section.category-beige {
        background: #aa7444;
    }

    .category-section.category-salvia {
        background: #a06c3f;
    }

    .category-section.category-rosa {
        background: #d0ab7a;
    }

    .category-section.category-terracota {
        background: #cf856b;
    }


    .category-section {
        scroll-margin-top: 110px;
        margin-bottom: 34px;
        padding: 38px;
        border: 1px solid rgba(100, 72, 53, .10);
        border-radius: 28px;
        box-shadow: 0 8px 25px rgba(76, 52, 38, .05);
    }

    .category-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        padding-bottom: 22px;
        margin-bottom: 27px;
        border-bottom: 1px solid rgba(88, 62, 46, .15);
    }

    .category-title-area {
        display: flex;
        align-items: baseline;
        gap: 13px;
    }

    .category-number {
        color: #9d806a;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 17px;
        font-style: italic;
    }

    .category-header h2 {
        margin: 0;
        color: #493327;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(30px, 4vw, 44px);
        font-weight: 400;
        line-height: 1;
    }

    .category-count {
        color: #806653;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }


    .products-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
    }

    .product-card {
        position: relative;
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
        background: #fffaf4;
        border: 1px solid rgba(91, 65, 48, .10);
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(71, 48, 34, .08);
        transition: transform .3s ease, box-shadow .3s ease;
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 38px rgba(71, 48, 34, .14);
        }


    .product-image {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background: #e4d6c7;
    }

        .product-image img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .55s ease;
        }

    .product-card:hover .product-image img {
        transform: scale(1.045);
    }

    .product-image::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient( to bottom, transparent 72%, rgba(55, 37, 27, .08) );
    }


    .product-status {
        position: absolute;
        top: 13px;
        left: 13px;
        z-index: 2;
        padding: 7px 11px;
        border-radius: 999px;
        background: rgba(255, 250, 244, .94);
        color: #684937;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
        box-shadow: 0 4px 12px rgba(54, 36, 26, .08);
    }

        .product-status.out {
            background: #55392b;
            color: white;
        }

    .product-info {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 20px 19px 18px;
    }

    .product-category {
        margin-bottom: 7px;
        color: #9a6f54;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .product-info h3 {
        margin: 0;
        color: #3f2c22;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 21px;
        font-weight: 400;
        line-height: 1.25;
    }

    .product-description {
        display: -webkit-box;
        min-height: 39px;
        margin: 9px 0 18px;
        overflow: hidden;
        color: #806d60;
        font-size: 11.5px;
        line-height: 1.6;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .product-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-top: auto;
    }

    .product-price {
        color: #5c3d2b;
        font-size: 17px;
        font-weight: 800;
        white-space: nowrap;
    }

    .product-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 10px 14px;
        border-radius: 999px;
        background: #60412f;
        color: white !important;
        text-decoration: none;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .8px;
        text-transform: uppercase;
        transition: all .25s ease;
    }

        .product-button:hover {
            background: #422c21;
            color: white !important;
            transform: translateY(-2px);
            box-shadow: 0 7px 16px rgba(67, 44, 31, .18);
        }

    .product-arrow {
        font-size: 13px;
        transition: transform .25s ease;
    }

    .product-button:hover .product-arrow {
        transform: translateX(4px);
    }


    .unavailable {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 9px 12px;
        border-radius: 999px;
        background: #e2d8ce;
        color: #79695e;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .admin-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        padding-top: 13px;
        margin-top: 15px;
        border-top: 1px solid rgba(82, 57, 42, .12);
    }

        .admin-actions a {
            padding: 6px 9px;
            border-radius: 999px;
            text-decoration: none;
            font-size: 8px;
            font-weight: 800;
            letter-spacing: .5px;
            text-transform: uppercase;
        }

    .edit-button {
        background: #e5dacf;
        color: #604938 !important;
    }

    .archive-button {
        background: #a8795c;
        color: white !important;
    }

    .delete-button {
        background: #dfccc6;
        color: #754e46 !important;
    }

        .edit-button:hover,
        .archive-button:hover,
        .delete-button:hover {
            opacity: .82;
        }

    .empty-products {
        max-width: 600px;
        margin: 30px auto;
        padding: 70px 30px;
        text-align: center;
        background: #fffaf4;
        border: 1px solid #dfd1c2;
        border-radius: 22px;
        box-shadow: 0 8px 25px rgba(76, 52, 38, .07);
    }

        .empty-products h3 {
            margin: 0 0 10px;
            color: #493327;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 30px;
            font-weight: 400;
        }

        .empty-products p {
            margin: 0;
            color: #806d60;
            font-size: 13px;
        }


    @@media (max-width: 1200px) {

        .products-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 900px) {

        .products-content {
            padding-left: 22px;
            padding-right: 22px;
        }

        .category-section {
            padding: 30px 25px;
        }

        .products-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 600px) {

        .products-content {
            padding: 25px 10px 0;
        }

        .products-heading {
            justify-content: center;
        }

        .admin-buttons {
            width: 100%;
        }

            .admin-buttons a {
                flex: 1;
                justify-content: center;
            }

        .category-navigation {
            justify-content: flex-start;
            flex-wrap: nowrap;
            overflow-x: auto;
            padding-bottom: 28px;
            scrollbar-width: none;
        }

            .category-navigation::-webkit-scrollbar {
                display: none;
            }

            .category-navigation a {
                flex: 0 0 auto;
                white-space: nowrap;
            }

        .category-section {
            padding: 26px 10px;
            border-radius: 22px;
        }

        .category-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 8px;
        }

            .category-header h2 {
                font-size: 32px;
            }

        .products-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .product-image {
            aspect-ratio: 1 / 1;
        }

        .product-info {
            padding: 14px 12px 13px;
        }

            .product-info h3 {
                font-size: 17px;
            }

        .product-description {
            font-size: 10px;
            min-height: 34px;
            margin: 7px 0 12px;
        }

        .product-price {
            font-size: 14px;
        }

        .product-button {
            padding: 8px 9px;
            font-size: 7px;
        }

        .unavailable {
            padding: 7px 8px;
            font-size: 7px;
        }
    }
</style>


<div class="products-page">

    <section class="products-hero">

        <div class="products-hero-content">

            <div class="products-hero-small">
                Dulce Antojo · Repostería artesanal
            </div>

            <h1>
                Nuestros Productos
            </h1>

        </div>

    </section>


    <main class="products-content">

        
        @if (User.IsInRole("Admin"))
        {
            <div class="products-heading">

                <div class="admin-buttons">

                    <a asp-action="Create">
                        <i class="bi bi-plus-lg"></i>
                        Nuevo producto
                    </a>

                    <a asp-action="Archived"
                       class="archived">

                        <i class="bi bi-archive"></i>
                        Archivados

                    </a>

                </div>

            </div>
        }


        <nav class="category-navigation">

            <a asp-action="Index"
               class="@(string.IsNullOrWhiteSpace(selectedCategory) ? "active" : "")">

                Todos

            </a>

            @foreach (var category in categories)
            {
                var categoryId = category
                    .Trim()
                    .ToLower()
                    .Replace(" ", "-");

                <a href="@Url.Action("Index", new { category = category })#categoria-@categoryId"
                   class="@(selectedCategory == category ? "active" : "")">

                    @category

                </a>
            }

        </nav>

        @if (Model.Any())
        {
            var productosPorCategoria = Model
                .GroupBy(p => p.CategoryNavigation?.Name
                    ?? p.Category
                    ?? "Otros productos")
                .OrderBy(g => g.Key);

            var categoryNumber = 1;

            foreach (var grupo in productosPorCategoria)
            {
                var categoryClass = categoryNumber switch
                {
                    1 => "category-chocolate",
                    2 => "category-caramel",
                    3 => "category-beige",
                    4 => "category-salvia",
                    5 => "category-rosa",
                    _ => "category-terracota"
                };

                var categoryId = grupo.Key
                    .Trim()
                    .ToLower()
                    .Replace(" ", "-");

                <section id="categoria-@categoryId"
                         class="category-section @categoryClass">


                    <div class="category-header">

                        <div class="category-title-area">

                            <span class="category-number">
                                @categoryNumber.ToString("00")
                            </span>

                            <h2>
                                @grupo.Key
                            </h2>

                        </div>

                        <span class="category-count">

                            @grupo.Count()

                            @(grupo.Count() == 1
                                ? "producto"
                                : "productos")

                        </span>

                    </div>



                    <div class="products-grid">

                        @foreach (var product in grupo)
                        {
                            <article class="product-card">

                                <div class="product-image">

                                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl"
                                             alt="@product.Name" />
                                    }
                                    else
                                    {
                                        <div style="
                                            width:100%;
                                            height:100%;
                                            display:flex;
                                            align-items:center;
                                            justify-content:center;
                                            color:#8b7667;
                                            background:#e6d9cc;">

                                            <i class="bi bi-image"
                                               style="font-size:34px;"></i>

                                        </div>
                                    }


                                    @if (product.Stock > 0)
                                    {
                                        <span class="product-status">
                                            Disponible
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="product-status out">
                                            Agotado
                                        </span>
                                    }

                                </div>

                              
                                <div class="product-info">

                                    <div class="product-category">
                                        @grupo.Key
                                    </div>

                                    <h3>
                                        @product.Name
                                    </h3>

                                    <p class="product-description">
                                        @product.Description
                                    </p>


                                    <div class="product-bottom">

                                        <span class="product-price">
                                            Bs @product.Price.ToString("N2")
                                        </span>

                                        @if (product.Stock > 0)
                                        {
                                            <a asp-action="Details"
                                               asp-route-id="@product.Id"
                                               class="product-button">

                                                Ver producto

                                                <span class="product-arrow">
                                                    →
                                                </span>

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="unavailable">
                                                Agotado
                                            </span>
                                        }

                                    </div>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <div class="admin-actions">

                                            <a asp-action="Edit"
                                               asp-route-id="@product.Id"
                                               class="edit-button">

                                                Editar

                                            </a>

                                            <a asp-action="Archive"
                                               asp-route-id="@product.Id"
                                               class="archive-button">

                                                <i class="bi bi-archive"></i>
                                                Archivar

                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@product.Id"
                                               class="delete-button">

                                                Eliminar

                                            </a>

                                        </div>
                                    }

                                </div>

                            </article>
                        }

                    </div>

                </section>

                categoryNumber++;
            }
        }
        else
        {
            <div class="empty-products">

                <h3>
                    No hay productos disponibles
                </h3>

                <p>
                    En este momento no tenemos productos para mostrar.
                </p>

            </div>
        }

    </main>

</div>