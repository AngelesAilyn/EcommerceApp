@using EcommerceApp.Models
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var homeController = User.IsInRole("Admin") ? "Admin" : "Home";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Dulce Antojo</title>

    <!-- PWA -->
    <link rel="manifest" href="~/manifest.json" />
    <meta name="theme-color" content="#3f291f" />

    <!-- Configuración para dispositivos móviles -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Dulce Antojo" />

    <!-- Icono PWA -->
    <link rel="apple-touch-icon" href="~/icons/icon-192.png" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EcommerceApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg main-navbar">
            <div class="container-fluid">

                <!-- Logo / nombre de la tienda -->
                <a class="navbar-brand"
                   asp-controller="@homeController"
                   asp-action="Index">
                    Dulce Antojo
                </a>

                <!-- Botón menú móvil -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">

                    <!-- MENÚ PRINCIPAL -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <!-- INICIO -->
                        <li class="nav-item">
                            <a class="nav-link @(controller == (User.IsInRole("Admin") ? "Admin" : "Home") && action == "Index" ? "active" : "")"
                               asp-controller="@homeController"
                               asp-action="Index">
                                <i class="bi bi-house-door"></i>
                                Inicio
                            </a>
                        </li>

                        <!-- PRODUCTOS -->
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Products" ? "active" : "")"
                               asp-controller="Products"
                               asp-action="Index">
                                <i class="bi bi-shop"></i>
                                Productos
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <!-- CATEGORÍAS -->
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Categories" ? "active" : "")"
                                   asp-controller="Categories"
                                   asp-action="Index">
                                    <i class="bi bi-tags"></i>
                                    Categorías
                                </a>
                            </li>

                            <!-- INVENTARIO -->
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Inventory" ? "active" : "")"
                                   asp-controller="Inventory"
                                   asp-action="Index">
                                    <i class="bi bi-box-seam"></i>
                                    Inventario
                                </a>
                            </li>

                            <!-- PEDIDOS -->
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Admin" && action == "Orders" ? "active" : "")"
                                   asp-controller="Admin"
                                   asp-action="Orders">
                                    <i class="bi bi-bag-check"></i>
                                    Pedidos
                                </a>
                            </li>

                            <!-- REPORTES -->
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Reports" ? "active" : "")"
                                   asp-controller="Reports"
                                   asp-action="Index">
                                    <i class="bi bi-bar-chart-line"></i>
                                    Reportes
                                </a>
                            </li>
                        }

                        @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin"))
                        {
                            <!-- CARRITO -->
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Cart" ? "active" : "")"
                                   asp-controller="Cart"
                                   asp-action="Index">
                                    <i class="bi bi-cart3"></i>
                                    Carrito
                                </a>
                            </li>

                            <!-- MIS COMPRAS -->
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Orders" ? "active" : "")"
                                   asp-controller="Orders"
                                   asp-action="MyOrders">
                                    <i class="bi bi-receipt"></i>
                                    Mis compras
                                </a>
                            </li>
                        }
                        <!-- INSTALAR PWA -->
                        <li class="nav-item">
                            <button id="installAppButton"
                                    class="nav-link border-0 bg-transparent"
                                    type="button"
                                    style="display: none;">
                                <i class="bi bi-download"></i>
                                Instalar aplicación
                            </button>
                        </li>

                        <!-- NOSOTROS -->
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Home" && action == "Privacy" ? "active" : "")"
                               asp-controller="Home"
                               asp-action="Privacy">
                                <i class="bi bi-info-circle"></i>
                                Nosotros
                            </a>
                        </li>

                    </ul>

                    <!-- MENÚ DE CUENTA -->
                    <ul class="navbar-nav align-items-lg-center">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- CERRAR SESIÓN -->
                            <li class="nav-item">
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">

                                    <button type="submit"
                                            class="nav-link header-logout border-0 bg-transparent">
                                        <i class="bi bi-box-arrow-right"></i>
                                        Cerrar sesión
                                    </button>

                                </form>
                            </li>
                        }
                        else
                        {
                            <!-- INICIAR SESIÓN -->
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    Iniciar sesión
                                </a>
                            </li>

                            <!-- REGISTRARSE -->
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    <i class="bi bi-person-plus"></i>
                                    Registrarse
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>
    <main role="main"><div class="page-content">@RenderBody()</div></main>
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="successToast" class="sweet-toast success-toast" role="alert"><div class="sweet-toast-icon"><i class="bi bi-check-lg"></i></div><div class="sweet-toast-content"><strong>¡Listo!</strong><span>@TempData["SuccessMessage"]</span></div><button type="button" class="sweet-toast-close" onclick="closeSweetToast()">×</button></div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div id="errorToast" class="sweet-toast error-toast" role="alert"><div class="sweet-toast-icon"><i class="bi bi-exclamation-lg"></i></div><div class="sweet-toast-content"><strong>Algo salió mal</strong><span>@TempData["ErrorMessage"]</span></div><button type="button" class="sweet-toast-close" onclick="closeErrorToast()">×</button></div>
    }
    <footer class="main-footer">
        <div class="footer-content">
            <div><div class="footer-brand">Dulce Antojo</div><p class="footer-description">Repostería artesanal hecha con amor. Rollos de canela, cookies, tortas y productos especiales para cada ocasión.</p></div>
            <div>
                <div class="footer-title">Síguenos</div><div class="footer-social">
                <a href="https://wa.me/59162639590" target="_blank" rel="noopener noreferrer"><i class="bi bi-whatsapp"></i> WhatsApp</a>
                <a href="https://www.instagram.com/aylen_kss" target="_blank" rel="noopener noreferrer"><i class="bi bi-instagram"></i> Instagram</a>
                <a href="https://www.tiktok.com/@@rollitos.de.canel65" target="_blank" rel="noopener noreferrer"><i class="bi bi-tiktok"></i> TikTok</a>
            </div>
        </div>
        <div><div class="footer-title">Encuéntranos</div><a class="footer-location" href="https://maps.app.goo.gl/tWSpvduiKeZFSvnQ6?g_st=ac" target="_blank" rel="noopener noreferrer"><i class="bi bi-geo-alt-fill"></i><span>Visita nuestra repostería<br />Ver ubicación en Google Maps</span></a></div>
    </div>
    <div class="footer-bottom"><p class="footer-copy">© @DateTime.Now.Year Dulce Antojo · Todos los derechos reservados</p></div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
        function closeSweetToast() {
            document.getElementById('successToast')?.remove();
        }

        function closeErrorToast() {
            document.getElementById('errorToast')?.remove();
        }

        setTimeout(() => {
            document.getElementById('successToast')?.remove();
            document.getElementById('errorToast')?.remove();
        }, 6000);
</script>

<!-- Registro del PWA -->
<script>
        if ("serviceWorker" in navigator) {

            window.addEventListener("load", () => {

                navigator.serviceWorker
                    .register("/service-worker.js")
                    .then(registration => {
                        console.log(
                            "Service Worker registrado correctamente:",
                            registration.scope
                        );
                    })
                    .catch(error => {
                        console.error(
                            "Error al registrar el Service Worker:",
                            error
                        );
                    });

            });

        }
</script>
<!-- Instalación de la PWA -->
<script>
        let deferredInstallPrompt = null;

        window.addEventListener("beforeinstallprompt", (event) => {

            // Evita que Chrome muestre automáticamente el aviso
            event.preventDefault();

            // Guardamos el evento para utilizarlo desde nuestro botón
            deferredInstallPrompt = event;

            // Mostramos el botón
            const installButton = document.getElementById("installAppButton");

            if (installButton) {
                installButton.style.display = "flex";
            }
        });

        document.addEventListener("DOMContentLoaded", () => {

            const installButton = document.getElementById("installAppButton");

            if (!installButton) {
                return;
            }

            installButton.addEventListener("click", async () => {

                if (!deferredInstallPrompt) {
                    return;
                }

                // Mostramos el cuadro de instalación del navegador
                deferredInstallPrompt.prompt();

                // Esperamos la respuesta del usuario
                const { outcome } = await deferredInstallPrompt.userChoice;

                console.log("Resultado de instalación:", outcome);

                // El evento solamente puede utilizarse una vez
                deferredInstallPrompt = null;

                // Ocultamos el botón después de utilizarlo
                installButton.style.display = "none";
            });

        });

        // Si la aplicación ya fue instalada,
        // ocultamos el botón.
        window.addEventListener("appinstalled", () => {

            const installButton = document.getElementById("installAppButton");

            if (installButton) {
                installButton.style.display = "none";
            }

            deferredInstallPrompt = null;

            console.log("Dulce Antojo fue instalada como aplicación.");
        });
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
