@model IEnumerable<EcommerceApp.Models.Order>

@{
    ViewData["Title"] = "Mis compras";
}

<div class="orders-page">
    <div class="orders-header">

        <div>
            <h1>Mis compras</h1>
            <p>Consulta el historial de tus pedidos y revisa sus detalles.</p>
        </div>

        <a asp-controller="Products"
           asp-action="Index"
           class="back-products-button">
            <i class="bi bi-arrow-left"></i>
            Seguir comprando
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="empty-orders">
            <div class="empty-orders-icon">
                <i class="bi bi-bag-x"></i>
            </div>

            <h2>Aún no tienes compras</h2>

            <p>
                Cuando realices tu primera compra,
                aparecerá aquí.
            </p>

            <a asp-controller="Products"
               asp-action="Index"
               class="orders-button">
                Ver productos
            </a>
        </div>
    }
    else
    {
        <div class="orders-list">

            @foreach (var order in Model)
            {
                <article class="order-card">

                    <div class="order-card-header">

                        <div>
                            <span class="order-label">Pedido</span>

                            <h2>
                                #@order.Id
                            </h2>
                        </div>

                        <span class="order-status">
                            @order.Status
                        </span>

                    </div>

                    <div class="order-info">

                        <div>
                            <span>Fecha</span>
                            <strong>
                                @order.OrderDate
                                .ToLocalTime()
                                .ToString("dd/MM/yyyy HH:mm")
                            </strong>
                        </div>

                        <div>
                            <span>Total</span>
                            <strong>
                                Bs. @order.Total.ToString("F2")
                            </strong>
                        </div>

                        <div>
                            <span>Método de pago</span>
                            <strong>
                                @order.PaymentMethod
                            </strong>
                        </div>

                        <div>
                            <span>Estado del pago</span>
                            <strong>
                                @order.PaymentStatus
                            </strong>
                        </div>

                        <div>
                            <span>Forma de entrega</span>
                            <strong>
                                @order.DeliveryMethod
                            </strong>
                        </div>

                    </div>

                    <div class="order-card-footer">

                        <span>
                            <i class="bi bi-receipt"></i>
                            Pedido #@order.Id
                        </span>

                        <a asp-controller="Orders"
                           asp-action="Details"
                           asp-route-id="@order.Id"
                           class="details-button">
                            Ver detalle
                            <i class="bi bi-arrow-right"></i>
                        </a>

                    </div>

                </article>
            }

        </div>
    }

</div>
<style>
    .orders-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 50px 25px 80px;
    }

    .orders-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 35px;
    }

    .back-products-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        background: #4a3426;
        color: white;
        border-radius: 10px;
        padding: 10px 17px;
        font-weight: 600;
        transition: 0.2s ease;
    }

        .back-products-button:hover {
            background: #6a4b36;
            color: white;
        }

        .orders-header h1 {
            margin: 0 0 8px;
            color: #4a3426;
            font-size: 2.4rem;
            font-weight: 700;
        }

        .orders-header p {
            margin: 0;
            color: #7a6250;
            font-size: 1rem;
        }

    .orders-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .order-card {
        background: #fffaf4;
        border: 1px solid #eadbca;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 5px 18px rgba(74, 52, 38, 0.08);
    }

    .order-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 22px 25px;
        border-bottom: 1px solid #eadbca;
    }

    .order-label {
        display: block;
        color: #92765d;
        font-size: 0.85rem;
        margin-bottom: 3px;
    }

    .order-card-header h2 {
        margin: 0;
        color: #4a3426;
        font-size: 1.5rem;
    }

    .order-status {
        padding: 8px 15px;
        border-radius: 20px;
        background: #f0dfca;
        color: #6d4d35;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .order-info {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 20px;
        padding: 25px;
    }

        .order-info div {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .order-info span {
            color: #92765d;
            font-size: 0.82rem;
        }

        .order-info strong {
            color: #4a3426;
            font-size: 0.95rem;
        }

    .order-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 18px 25px;
        background: #f8eee3;
        border-top: 1px solid #eadbca;
    }

        .order-card-footer > span {
            color: #806650;
            font-size: 0.9rem;
        }

    .details-button,
    .orders-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        background: #4a3426;
        color: white;
        border-radius: 10px;
        padding: 10px 17px;
        font-weight: 600;
        transition: 0.2s ease;
    }

        .details-button:hover,
        .orders-button:hover {
            background: #6a4b36;
            color: white;
            transform: translateY(-1px);
        }

    .empty-orders {
        text-align: center;
        background: #fffaf4;
        border: 1px solid #eadbca;
        border-radius: 18px;
        padding: 60px 25px;
        box-shadow: 0 5px 18px rgba(74, 52, 38, 0.06);
    }

    .empty-orders-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f0dfca;
        color: #6d4d35;
        font-size: 2rem;
    }

    .empty-orders h2 {
        margin: 0 0 10px;
        color: #4a3426;
    }

    .empty-orders p {
        margin: 0 auto 25px;
        color: #806650;
    }

    @@media (max-width: 900px) {
        .order-info {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .orders-page {
            padding: 35px 15px 60px;
        }

        .orders-header h1 {
            font-size: 2rem;
        }

        .order-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .order-info {
            grid-template-columns: 1fr;
        }

        .order-card-footer {
            align-items: stretch;
            flex-direction: column;
        }

        .details-button {
            width: 100%;
        }
        @@media (max-width: 600px) {
            .orders-header {
                align-items: stretch;
                flex-direction: column;
            }

            .back-products-button {
                justify-content: center;
            }
        }
    }
</style>