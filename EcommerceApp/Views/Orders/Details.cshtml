@model EcommerceApp.Models.Order

@{
    ViewData["Title"] = "Pedido confirmado";
}

<div class="confirmation-page">

    <div class="confirmation-success">

        <div class="confirmation-success-icon">
            <i class="bi bi-check-lg"></i>
        </div>

        <span class="confirmation-eyebrow">
            Compra completada
        </span>

        <h1>
            ¡Pedido realizado!
        </h1>

        <p>
            Tu pedido fue registrado correctamente.
        </p>

    </div>


    <div class="confirmation-card">

        <div class="confirmation-header">

            <div class="confirmation-order-heading">

                <span class="confirmation-order-label">
                    Pedido
                </span>

                <h2>
                    #@Model.Id
                </h2>

            </div>

            <span class="confirmation-status">
                @Model.Status
            </span>

        </div>


        <div class="confirmation-info">

            <div class="confirmation-info-item">

                <span>
                    <i class="bi bi-calendar3"></i>
                    Fecha
                </span>

                <strong>
                    @(Model.OrderDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                </strong>

            </div>


            <div class="confirmation-info-item">

                <span>
                    <i class="bi bi-cash-coin"></i>
                    Total
                </span>

                <strong class="confirmation-info-total">
                    Bs. @Model.Total.ToString("F2")
                </strong>

            </div>


            <div class="confirmation-info-item">

                <span>
                    <i class="bi bi-box-seam"></i>
                    Estado del pedido
                </span>

                <strong>
                    @Model.Status
                </strong>

            </div>


            <div class="confirmation-info-item">

                <span>
                    <i class="bi bi-credit-card"></i>
                    Método de pago
                </span>

                <strong>
                    @Model.PaymentMethod
                </strong>

            </div>


            <div class="confirmation-info-item">

                <span>
                    <i class="bi bi-check-circle"></i>
                    Estado del pago
                </span>

                <strong>
                    @Model.PaymentStatus
                </strong>

            </div>


            <div class="confirmation-info-item">

                <span>
                    <i class="bi bi-truck"></i>
                    Forma de entrega
                </span>

                <strong>
                    @Model.DeliveryMethod
                </strong>

            </div>

        </div>


        <div class="confirmation-products">

            <div class="confirmation-products-heading">

                <div>

                    <span class="confirmation-section-label">
                        Resumen
                    </span>

                    <h3>
                        Productos
                    </h3>

                </div>

                <span class="confirmation-product-count">
                    @Model.OrderDetails.Count producto@(Model.OrderDetails.Count == 1 ? "" : "s")
                </span>

            </div>


            <div class="confirmation-products-list">

                @foreach (var detail in Model.OrderDetails)
                {
                    <div class="confirmation-product">

                        <div class="confirmation-product-icon">
                            <i class="bi bi-cake2"></i>
                        </div>


                        <div class="confirmation-product-info">

                            <strong>
                                @(detail.Product?.Name ?? "Producto")
                            </strong>

                            <span>
                                Cantidad: @detail.Quantity
                            </span>

                        </div>


                        <div class="confirmation-product-price">

                            <span>
                                Bs. @detail.UnitPrice.ToString("F2") c/u
                            </span>

                            <strong>
                                Bs. @detail.Subtotal.ToString("F2")
                            </strong>

                        </div>

                    </div>
                }

            </div>

        </div>


        <div class="confirmation-total">

            <span>
                Total del pedido
            </span>

            <strong>
                Bs. @Model.Total.ToString("F2")
            </strong>

        </div>


        <div class="confirmation-actions">

            <a asp-controller="Orders"
               asp-action="MyOrders"
               class="confirmation-button confirmation-button-secondary">

                <i class="bi bi-bag"></i>

                Mis compras

            </a>


            <a asp-controller="Products"
               asp-action="Index"
               class="confirmation-button confirmation-button-primary">

                <i class="bi bi-shop"></i>

                Seguir comprando

            </a>

        </div>

    </div>

</div>


<style>

    .confirmation-page {
        width: 100%;
        max-width: 980px;
        margin: 0 auto;
        padding: 42px 20px 75px;
        box-sizing: border-box;
    }


    .confirmation-success {
        text-align: center;
        margin-bottom: 27px;
    }


    .confirmation-success-icon {
        width: 62px;
        height: 62px;
        margin: 0 auto 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e8f2e5;
        color: #588052;
        font-size: 28px;
        box-shadow: 0 5px 15px rgba(88, 128, 82, .10);
    }


    .confirmation-eyebrow {
        display: block;
        margin-bottom: 5px;
        color: #b8865b;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.3px;
        text-transform: uppercase;
    }


    .confirmation-success h1 {
        margin: 0;
        color: #4a3426;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 32px;
        line-height: 1.2;
    }


    .confirmation-success p {
        margin: 7px 0 0;
        color: #786960;
        font-size: 14px;
        line-height: 1.5;
    }


    .confirmation-card {
        width: 100%;
        overflow: hidden;
        background: #fffaf4;
        border: 1px solid #e3d2c0;
        border-radius: 18px;
        box-shadow: 0 9px 26px rgba(74, 52, 38, .08);
        box-sizing: border-box;
    }


    .confirmation-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 18px 22px;
        background: #f8eee3;
        border-bottom: 1px solid #e5d5c5;
    }


    .confirmation-order-heading {
        min-width: 0;
    }


    .confirmation-order-label {
        display: block;
        margin-bottom: 2px;
        color: #a17d61;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .9px;
        text-transform: uppercase;
    }


    .confirmation-header h2 {
        margin: 0;
        color: #4a3426;
        font-size: 21px;
        line-height: 1.2;
    }


    .confirmation-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 29px;
        padding: 5px 13px;
        border: 1px solid #dfc6ac;
        border-radius: 20px;
        background: #f1dfca;
        color: #79583e;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }


    .confirmation-info {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0;
        padding: 19px 22px;
        border-bottom: 1px solid #e7d9cc;
        box-sizing: border-box;
    }


    .confirmation-info-item {
        min-width: 0;
        padding: 2px 18px;
        border-right: 1px solid #eaded2;
        box-sizing: border-box;
    }


        .confirmation-info-item:nth-child(3n + 1) {
            padding-left: 0;
        }


        .confirmation-info-item:nth-child(3n) {
            padding-right: 0;
            border-right: none;
        }


        .confirmation-info-item:nth-child(n + 4) {
            margin-top: 17px;
            padding-top: 17px;
            border-top: 1px solid #eee3d9;
        }


        .confirmation-info-item > span {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 6px;
            color: #9a806d;
            font-size: 10px;
            font-weight: 600;
            line-height: 1.3;
        }


            .confirmation-info-item > span i {
                color: #b8865b;
                font-size: 11px;
            }


        .confirmation-info-item > strong {
            display: block;
            overflow-wrap: anywhere;
            color: #4a3426;
            font-size: 12px;
            line-height: 1.4;
        }


        .confirmation-info-item .confirmation-info-total {
            color: #9f7048;
            font-size: 14px;
            font-weight: 700;
        }


    .confirmation-products {
        padding: 20px 22px 0;
        box-sizing: border-box;
    }


    .confirmation-products-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 9px;
    }


    .confirmation-section-label {
        display: block;
        margin-bottom: 2px;
        color: #b8865b;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }


    .confirmation-products-heading h3 {
        margin: 0;
        color: #4a3426;
        font-size: 18px;
        line-height: 1.2;
    }


    .confirmation-product-count {
        color: #917b6b;
        font-size: 10px;
        font-weight: 600;
        white-space: nowrap;
    }


    .confirmation-products-list {
        border-top: 1px solid #eee3d9;
    }


    .confirmation-product {
        display: flex;
        align-items: center;
        gap: 13px;
        width: 100%;
        min-width: 0;
        padding: 13px 0;
        border-bottom: 1px solid #eee3d9;
        box-sizing: border-box;
    }


    .confirmation-product-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #f1e2d2;
        color: #b17b4e;
        font-size: 16px;
    }


    .confirmation-product-info {
        min-width: 0;
        flex: 1 1 auto;
    }


        .confirmation-product-info strong {
            display: block;
            margin-bottom: 3px;
            overflow-wrap: anywhere;
            color: #493328;
            font-size: 13px;
            line-height: 1.35;
        }


        .confirmation-product-info span {
            display: block;
            color: #917e70;
            font-size: 10px;
            line-height: 1.4;
        }


    .confirmation-product-price {
        flex: 0 0 auto;
        min-width: 120px;
        text-align: right;
    }


        .confirmation-product-price span {
            display: block;
            margin-bottom: 3px;
            color: #917e70;
            font-size: 10px;
            line-height: 1.3;
        }


        .confirmation-product-price strong {
            color: #4a3426;
            font-size: 13px;
            line-height: 1.3;
        }


    .confirmation-total {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin: 0 22px;
        padding: 18px 0;
        border-bottom: 1px solid #e5d5c5;
        box-sizing: border-box;
    }


        .confirmation-total span {
            color: #665247;
            font-size: 13px;
            font-weight: 600;
        }


        .confirmation-total strong {
            color: #9f7048;
            font-size: 21px;
            font-weight: 700;
            white-space: nowrap;
        }


    .confirmation-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        padding: 15px 22px;
        background: #f3e7da;
        box-sizing: border-box;
    }


    .confirmation-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-width: 135px;
        padding: 9px 15px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        transition: .2s ease;
        box-sizing: border-box;
    }


    .confirmation-button-primary {
        background: #b8865b;
        color: #fff;
        border: 1px solid #b8865b;
    }


        .confirmation-button-primary:hover {
            background: #9f7048;
            border-color: #9f7048;
            color: #fff;
            transform: translateY(-1px);
        }


    .confirmation-button-secondary {
        background: #fffaf4;
        color: #6b503d;
        border: 1px solid #d4bda7;
    }


        .confirmation-button-secondary:hover {
            background: #f1e2d2;
            border-color: #b99576;
            color: #4a3426;
            transform: translateY(-1px);
        }


    @@media (max-width: 800px) {

        .confirmation-page {
            padding: 35px 15px 65px;
        }


        .confirmation-info {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }


        .confirmation-info-item {
            padding: 0 13px;
            border-right: 1px solid #eaded2;
        }


            .confirmation-info-item:nth-child(3n + 1) {
                padding-left: 13px;
            }


            .confirmation-info-item:nth-child(3n) {
                padding-right: 13px;
                border-right: 1px solid #eaded2;
            }


            .confirmation-info-item:nth-child(2n + 1) {
                padding-left: 0;
            }


            .confirmation-info-item:nth-child(2n) {
                padding-right: 0;
                border-right: none;
            }


            .confirmation-info-item:nth-child(n + 3) {
                margin-top: 16px;
                padding-top: 16px;
                border-top: 1px solid #eee3d9;
            }
    }


    @@media (max-width: 600px) {

        .confirmation-page {
            padding: 30px 12px 55px;
        }


        .confirmation-success {
            margin-bottom: 22px;
        }


        .confirmation-success-icon {
            width: 56px;
            height: 56px;
            font-size: 25px;
        }


        .confirmation-success h1 {
            font-size: 28px;
        }


        .confirmation-success p {
            font-size: 13px;
        }


        .confirmation-card {
            border-radius: 15px;
        }


        .confirmation-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
            padding: 16px;
        }


            .confirmation-header h2 {
                font-size: 19px;
            }


        .confirmation-info {
            grid-template-columns: 1fr;
            padding: 17px 16px;
        }


        .confirmation-info-item,
        .confirmation-info-item:nth-child(3n),
        .confirmation-info-item:nth-child(3n + 1),
        .confirmation-info-item:nth-child(2n),
        .confirmation-info-item:nth-child(2n + 1) {
            padding: 0 0 13px;
            border-right: none;
            border-bottom: 1px solid #eee3d9;
        }


            .confirmation-info-item:nth-child(n + 3) {
                margin-top: 13px;
                padding-top: 0;
                border-top: none;
            }


            .confirmation-info-item:last-child {
                padding-bottom: 0;
                border-bottom: none;
            }


        .confirmation-products {
            padding: 18px 16px 0;
        }


        .confirmation-products-heading {
            align-items: flex-start;
            flex-direction: column;
            gap: 4px;
        }


        .confirmation-product {
            align-items: flex-start;
        }


        .confirmation-product-price {
            min-width: 90px;
        }


        .confirmation-total {
            margin: 0 16px;
            padding: 17px 0;
        }


            .confirmation-total strong {
                font-size: 19px;
            }


        .confirmation-actions {
            align-items: stretch;
            flex-direction: column;
            padding: 14px 16px;
        }


        .confirmation-button {
            width: 100%;
        }
    }


    @@media (max-width: 420px) {

        .confirmation-product {
            display: grid;
            grid-template-columns: 38px minmax(0, 1fr);
            gap: 10px;
        }


        .confirmation-product-price {
            grid-column: 2;
            min-width: 0;
            text-align: left;
        }


        .confirmation-product-icon {
            grid-row: span 2;
        }


        .confirmation-total {
            align-items: flex-start;
            flex-direction: column;
            gap: 5px;
        }
    }

</style>