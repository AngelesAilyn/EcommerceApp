@model IEnumerable<EcommerceApp.Models.Product>

@{
    ViewData["Title"] = "Inicio";

    var categorias = Model
        .Where(p => !string.IsNullOrWhiteSpace(p.Category))
        .GroupBy(p => p.Category!)
        .Select(g => g.First())
        .ToList();
}

<style>


    .home-page {
        width: 100%;
        margin: 0;
        padding: 0;
        background: #f7f1e8;
        color: #3d2b20;
        overflow-x: hidden;
    }


    .hero {
        position: relative;
        width: 100%;
        height: auto;
        min-height: 0;
        overflow: hidden;
        background: #3d2b20;
    }

    .hero-image {
        display: block;
        width: 100%;
        height: auto;
        max-width: 100%;
        object-fit: contain;
    }

    .hero::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        background: linear-gradient( rgba(48, 31, 21, 0.28), rgba(40, 27, 18, 0.38) );
        pointer-events: none;
    }

    .hero-content {
        position: absolute;
        z-index: 2;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: min(900px, 90%);
        padding: 50px 30px;
        text-align: center;
        color: white;
        box-sizing: border-box;
    }

    .hero-small {
        margin-bottom: 22px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 5px;
        text-transform: uppercase;
        color: #f8eee1;
    }

    .hero h1 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(65px, 9vw, 120px);
        line-height: 0.95;
        font-weight: 400;
        letter-spacing: -3px;
        color: white;
    }

    .hero p {
        max-width: 600px;
        margin: 28px auto 38px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 22px;
        font-style: italic;
        line-height: 1.5;
        color: #fffaf4;
    }

    .hero-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 190px;
        padding: 15px 30px;
        border: 1px solid white;
        border-radius: 0;
        background: white;
        color: #3d2b20;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        transition: all 0.3s ease;
    }

        .hero-button:hover {
            background: transparent;
            color: white;
            transform: translateY(-3px);
        }


    .products-section {
        padding: 105px 40px 115px;
        background: #f7f1e8;
    }

    .products-title {
        max-width: 750px;
        margin: 0 auto 60px;
        text-align: center;
    }

        .products-title span {
            display: block;
            margin-bottom: 16px;
            color: #96775d;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 4px;
            text-transform: uppercase;
        }

        .products-title h2 {
            margin: 0 0 18px;
            color: #3d2b20;
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(38px, 5vw, 58px);
            font-weight: 400;
            line-height: 1.05;
        }

        .products-title p {
            margin: 0 auto;
            color: #79675a;
            font-size: 16px;
            line-height: 1.7;
        }


    .category-grid {
        width: 100%;
        max-width: 1250px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
    }


    .category-card {
        position: relative;
        display: block;
        width: 100%;
        min-width: 0;
        aspect-ratio: 4 / 5;
        overflow: hidden;
        text-decoration: none;
        background: #ded5c9;
        box-sizing: border-box;
    }

        .category-card img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            transition: transform 0.7s ease;
        }

        .category-card::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 1;
            background: linear-gradient( to top, rgba(39, 25, 17, 0.82) 0%, rgba(39, 25, 17, 0.22) 45%, rgba(39, 25, 17, 0) 72% );
        }

        .category-card:hover img {
            transform: scale(1.08);
        }


    .category-info {
        position: absolute;
        z-index: 2;
        left: 25px;
        right: 25px;
        bottom: 25px;
        color: white;
    }

        .category-info h3 {
            margin: 0 0 9px;
            color: white;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 26px;
            font-weight: 400;
            line-height: 1.1;
        }

        .category-info span {
            color: rgba(255,255,255,0.88);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }



    .no-products {
        max-width: 700px;
        margin: 0 auto;
        padding: 50px;
        text-align: center;
        color: #79675a;
        background: #fffaf4;
    }


    .why-section {
        position: relative;
        min-height: 610px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background-image: url("https://tse2.mm.bing.net/th/id/OIP.WkgctQPwITB5nl-SnAytngHaE8?r=0&rs=1&pid=ImgDetMain&o=7&rm=3");
        background-size: cover;
        background-position: center;
    }

    .why-content {
        width: min(780px, 90%);
        padding: 70px 30px;
        text-align: center;
        color: white;
    }

        .why-content small {
            display: block;
            margin-bottom: 20px;
            color: #ead7c4;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 4px;
            text-transform: uppercase;
        }

        .why-content h2 {
            margin: 0 0 25px;
            color: white;
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(42px, 6vw, 66px);
            font-weight: 400;
            line-height: 1.05;
        }

        .why-content p {
            max-width: 650px;
            margin: 0 auto 32px;
            color: rgba(255,255,255,0.91);
            font-size: 17px;
            line-height: 1.9;
        }

    .why-values {
        margin-bottom: 38px;
        color: #f2dfcb;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

        .why-values span {
            margin: 0 12px;
        }

    .about-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 15px 32px;
        border: 1px solid white;
        border-radius: 0;
        background: white;
        color: #3d2b20;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        transition: all 0.3s ease;
    }

        .about-button:hover {
            background: transparent;
            color: white;
            transform: translateY(-3px);
        }


    @@media (max-width: 1100px) {

        .category-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            max-width: 850px;
        }

        .category-card {
            aspect-ratio: 4 / 5;
        }
    }


    @@media (max-width: 600px) {

        .hero {
            width: 100%;
            height: auto;
            min-height: 0;
        }

        .hero-image {
            width: 100%;
            height: auto;
            max-width: 100%;
            display: block;
            object-fit: contain;
        }

        .hero-content {
            width: 92%;
            padding: 15px;
        }

        .hero-small {
            margin-bottom: 12px;
            font-size: 8px;
            letter-spacing: 2px;
        }

        .hero h1 {
            font-size: 48px;
            line-height: 1;
            letter-spacing: -2px;
        }

        .hero p {
            max-width: 300px;
            margin: 16px auto 22px;
            font-size: 15px;
            line-height: 1.4;
        }

        .hero-button {
            min-width: 0;
            padding: 12px 18px;
            font-size: 9px;
            letter-spacing: 1px;
        }

     
        .products-section {
            padding: 55px 10px 65px;
        }

        .products-title {
            margin-bottom: 30px;
            padding: 0 10px;
        }

            .products-title span {
                margin-bottom: 12px;
                font-size: 9px;
                letter-spacing: 2.5px;
            }

            .products-title h2 {
                margin-bottom: 12px;
                font-size: 34px;
                line-height: 1.1;
            }

            .products-title p {
                font-size: 14px;
                line-height: 1.5;
            }

 
        .category-grid {
            width: 100%;
            max-width: none;
            margin: 0;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
            padding: 0;
        }

        .category-card {
            width: 100%;
            height: auto;
            min-width: 0;
            aspect-ratio: 4 / 5;
        }

            .category-card img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: center;
            }

        .category-info {
            left: 12px;
            right: 12px;
            bottom: 12px;
        }

            .category-info h3 {
                margin-bottom: 5px;
                font-size: 19px;
                line-height: 1.05;
            }

            .category-info span {
                font-size: 8px;
                letter-spacing: 0.8px;
            }

        .why-section {
            min-height: 500px;
        }

        .why-content {
            width: 92%;
            padding: 50px 15px;
        }

            .why-content small {
                margin-bottom: 15px;
                font-size: 9px;
                letter-spacing: 2.5px;
            }

            .why-content h2 {
                margin-bottom: 18px;
                font-size: 38px;
                line-height: 1.1;
            }

            .why-content p {
                margin-bottom: 25px;
                font-size: 14px;
                line-height: 1.65;
            }

        .why-values {
            margin-bottom: 28px;
            font-size: 9px;
            line-height: 2;
            letter-spacing: 1.2px;
        }

            .why-values span {
                margin: 0 5px;
            }

        .about-button {
            padding: 13px 22px;
            font-size: 10px;
            letter-spacing: 1.3px;
        }
    }

</style>


<div class="home-page">


    <section class="hero">

        <img class="hero-image"
             src="https://img.freepik.com/premium-photo/assorted-delicious-mousse-cakes-with-fruit-jam-cream-table-created-with-generative-ai_124507-94309.jpg"
             alt="Dulce Antojo" />

        <div class="hero-content">

            <div class="hero-small">
                Repostería artesanal
            </div>

            <h1>
                Dulce Antojo
            </h1>

            <p>
                Hecho para esos momentos en los que simplemente
                se te antoja algo dulce.
            </p>

            <a asp-controller="Products"
               asp-action="Index"
               class="hero-button">

                Descubre nuestros sabores

            </a>

        </div>

    </section>


    <section class="products-section">

        <div class="products-title">

            <span>
                Una elección difícil
            </span>

            <h2>
                ¿Qué se te antoja hoy?
            </h2>

            <p>
                Explora nuestros sabores y encuentra algo que
                quieras disfrutar.
            </p>

        </div>


        @if (categorias.Any())
        {
            <div class="category-grid">

                @foreach (var product in categorias)
                {
                    <a asp-controller="Products"
                       asp-action="Index"
                       asp-route-category="@product.Category"
                       class="category-card">

                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl"
                                 alt="@product.Category" />
                        }
                        else
                        {
                            <div style="
                                width:100%;
                                height:100%;
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                background:#ded5c9;
                                color:#79675a;">

                                Sin imagen

                            </div>
                        }

                        <div class="category-info">

                            <h3>
                                @product.Category
                            </h3>

                            <span>
                                Explorar categoría →
                            </span>

                        </div>

                    </a>
                }

            </div>
        }
        else
        {
            <div class="no-products">

                No hay productos disponibles actualmente.

            </div>
        }

    </section>


    <section class="why-section">

        <div class="why-content">

            <small>
                Dulce Antojo
            </small>

            <h2>
                El gusto está en los pequeños detalles
            </h2>

            <p>
                Preparamos cada producto con dedicación para
                convertir un simple antojo en un momento especial.
                Queremos que elegir algo dulce también sea parte
                de la experiencia.
            </p>

            <div class="why-values">

                <span>Artesanal</span>

                ·

                <span>Calidad</span>

                ·

                <span>Dedicación</span>

            </div>

            <a asp-controller="Home"
               asp-action="Privacy"
               class="about-button">

                Conócenos

            </a>

        </div>

    </section>

</div>