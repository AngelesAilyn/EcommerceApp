<script>

    document.addEventListener("DOMContentLoaded", function() {

        const tabs = document.querySelectorAll(".information-tab");
        const sections = document.querySelectorAll(".information-section");

        tabs.forEach(function(tab) {

            tab.addEventListener("click", function() {

                const selectedSection = this.dataset.section;

                tabs.forEach(function(item) {
                    item.classList.remove("active");
                });

                sections.forEach(function(section) {
                    section.classList.remove("active");
                });

                this.classList.add("active");

                const selected = document.getElementById(selectedSection);

                if (selected) {
                    selected.classList.add("active");
                }

            });

        });


        const privacyQuestions = document.querySelectorAll(".privacy-question");

        privacyQuestions.forEach(function(question) {

            question.addEventListener("click", function() {

                const item = this.closest(".privacy-accordion-item");
                const isOpen = item.classList.contains("open");

                document.querySelectorAll(".privacy-accordion-item").forEach(function(otherItem) {
                    otherItem.classList.remove("open");
                });

                if (!isOpen) {
                    item.classList.add("open");
                }

            });

        });

    });

</script>