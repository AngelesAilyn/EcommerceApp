@model IEnumerable<EcommerceApp.Models.Category>

@{
    ViewData["Title"] = "Categorías";
}

<style>
    .admin-list-page {
        min-height: calc(100vh - 100px);
        padding: 35px 20px 70px;
        background: #f7f1e9;
    }

    .page-shell {
        width: min(1180px, 100%);
        margin: 0 auto;
    }

    .page-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 25px;
        margin-bottom: 25px;
    }

        .page-heading > div {
            min-width: 0;
        }

    .eyebrow {
        display: block;
        margin-bottom: 7px;
        color: #9a7258;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .page-heading h1 {
        margin: 0;
        color: #3f2c22;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 42px;
        font-weight: 400;
    }

    .page-heading p {
        margin: 8px 0 0;
        color: #806d60;
        font-size: 13px;
    }

    .btn-bakery {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex-shrink: 0;
        padding: 11px 17px;
        border-radius: 999px;
        background: #5b3d2c;
        color: #fff !important;
        text-decoration: none;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .7px;
        text-transform: uppercase;
        box-shadow: 0 7px 16px rgba(74, 52, 38, .14);
        transition: .25s ease;
    }

        .btn-bakery:hover {
            background: #422c21;
            color: #fff !important;
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(74, 52, 38, .18);
        }

    .admin-table-card {
        overflow: hidden;
        background: #fffaf4;
        border: 1px solid #dfd1c2;
        border-radius: 20px;
        box-shadow: 0 10px 28px rgba(74, 52, 38, .08);
    }

    .admin-table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .admin-table {
        width: 100%;
        min-width: 720px;
        border-collapse: collapse;
    }

        .admin-table thead {
            background: #eee2d4;
        }

        .admin-table th {
            padding: 15px 18px;
            color: #705442;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: 1.1px;
            text-align: left;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .admin-table td {
            padding: 17px 18px;
            border-top: 1px solid #e9ded2;
            color: #756358;
            font-size: 12px;
            vertical-align: middle;
        }

        .admin-table tbody tr {
            transition: background .2s ease;
        }

            .admin-table tbody tr:hover {
                background: #f8f0e7;
            }

        .admin-table td strong {
            color: #493327;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 16px;
            font-weight: 400;
        }

    .status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 70px;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

        .status-pill.ok {
            background: #e3eadf;
            color: #58704f;
        }

        .status-pill.bad {
            background: #eadbd5;
            color: #805c50;
        }

    .table-actions {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-wrap: wrap;
    }

        .table-actions form {
            margin: 0;
        }

    .table-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 8px 11px;
        border: 1px solid #d9cabb;
        border-radius: 999px;
        background: #eee4da;
        color: #604838;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .6px;
        text-transform: uppercase;
        text-decoration: none;
        cursor: pointer;
        transition: .2s ease;
        white-space: nowrap;
    }

        .table-btn:hover {
            background: #e1d3c4;
            color: #4a3426;
            transform: translateY(-1px);
        }

        .table-btn.primary {
            background: #5b3d2c;
            border-color: #5b3d2c;
            color: #fff !important;
        }

            .table-btn.primary:hover {
                background: #422c21;
                border-color: #422c21;
                color: #fff !important;
            }

    .category-message {
        margin: 0 auto 20px;
        padding: 12px 16px;
        border: 1px solid #ddcdbc;
        border-radius: 14px;
        background: #fffaf4;
        color: #604838;
        font-size: 12px;
        text-align: center;
        box-shadow: 0 6px 18px rgba(74, 52, 38, .06);
    }

        .category-message strong {
            color: #4a3426;
        }

    .empty-category {
        max-width: 600px;
        margin: 35px auto;
        padding: 55px 30px;
        border: 1px solid #dfd1c2;
        border-radius: 20px;
        background: #fffaf4;
        text-align: center;
        box-shadow: 0 10px 28px rgba(74, 52, 38, .07);
    }

    .empty-category-icon {
        margin-bottom: 10px;
        font-size: 40px;
    }

    .empty-category h2 {
        margin: 0 0 8px;
        color: #493327;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 28px;
        font-weight: 400;
    }

    .empty-category p {
        margin: 0 0 20px;
        color: #806d60;
        font-size: 13px;
    }

    @@media (max-width: 800px) {
        .admin-list-page {
            padding: 28px 14px 55px;
        }

        .page-heading {
            align-items: flex-start;
            flex-direction: column;
            gap: 18px;
        }

            .page-heading h1 {
                font-size: 36px;
            }

        .btn-bakery {
            width: 100%;
        }

        .admin-table-card {
            border-radius: 16px;
        }

        .admin-table th,
        .admin-table td {
            padding: 13px 14px;
        }
    }

    @@media (max-width: 500px) {
        .admin-list-page {
            padding: 24px 10px 45px;
        }

        .page-heading h1 {
            font-size: 32px;
        }

        .page-heading p {
            font-size: 12px;
            line-height: 1.5;
        }

        .admin-table {
            min-width: 680px;
        }

            .admin-table th,
            .admin-table td {
                padding: 12px;
            }

                .admin-table td strong {
                    font-size: 15px;
                }
    }
</style>

<div class="admin-list-page">

    <div class="page-shell">

        <div class="page-heading">

            <div>
                <span class="eyebrow">
                    Administración
                </span>

                <h1>
                    Categorías
                </h1>

                <p>
                    Organiza los productos de Dulce Antojo sin llenar la pantalla de tarjetas.
                </p>
            </div>

            <a asp-action="Create" class="btn-bakery">
                <i class="bi bi-plus-lg"></i>
                Nueva categoría
            </a>

        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="category-message">
                ✓ <strong>@TempData["SuccessMessage"]</strong>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="empty-category">

                <div class="empty-category-icon">
                    🍰
                </div>

                <h2>
                    Aún no hay categorías
                </h2>

                <p>
                    Crea la primera categoría para comenzar a organizar tus productos.
                </p>

                <a asp-action="Create" class="btn-bakery">
                    <i class="bi bi-plus-lg"></i>
                    Crear primera categoría
                </a>

            </div>
        }
        else
        {
            <div class="admin-table-card">

                <div class="admin-table-wrap">

                    <table class="admin-table">

                        <thead>
                            <tr>
                                <th>Categoría</th>
                                <th>Descripción</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var category in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @category.Name
                                        </strong>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(category.Description)
                                            ? "Sin descripción"
                                            : category.Description)
                                    </td>

                                    <td>

                                        <span class="status-pill @(category.IsActive ? "ok" : "bad")">
                                            @(category.IsActive ? "Activa" : "Inactiva")
                                        </span>

                                    </td>

                                    <td>

                                        <div class="table-actions">

                                            <a class="table-btn primary"
                                               asp-action="Edit"
                                               asp-route-id="@category.Id">

                                                <i class="bi bi-pencil"></i>
                                                Editar

                                            </a>

                                            <form asp-action="ToggleStatus"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@category.Id" />

                                                <button class="table-btn"
                                                        type="submit">

                                                    @(category.IsActive
                                                        ? "Desactivar"
                                                        : "Activar")

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }

    </div>

</div>