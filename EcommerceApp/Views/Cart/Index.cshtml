@model List<EcommerceApp.Controllers.CartItemViewModel>

@{
    ViewData["Title"] = "Mi carrito";
    decimal total = Model.Sum(item => item.Subtotal);
}

<div class="cart-page">

    <div class="page-shell" style="padding-top:0">

        <div class="page-heading">

            <div>
                <span class="eyebrow">Tu selección</span>

                <h1>Mi carrito</h1>

                <p>
                    Revisa tus productos antes de realizar tu compra.
                </p>
            </div>

            <a asp-controller="Products"
               asp-action="Index"
               class="btn-outline-bakery">
                <i class="bi bi-arrow-left"></i>
                Seguir comprando
            </a>

        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ErrorMessage"]
            </div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="empty-orders">

                <div class="empty-orders-icon">
                    <i class="bi bi-bag"></i>
                </div>

                <h2>Tu carrito está vacío</h2>

                <p class="text-muted">
                    Agrega algo delicioso para comenzar tu compra.
                </p>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn-bakery">
                    Ver productos
                </a>

            </div>
        }
        else
        {
            <div class="cart-layout">

                <div class="cart-list">

                    @foreach (var item in Model)
                    {
                        <article class="cart-item">

                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img class="cart-item-image"
                                     src="@item.ImageUrl"
                                     alt="@item.Name" />
                            }
                            else
                            {
                                <div class="cart-item-image cart-item-image-placeholder">
                                    <i class="bi bi-cake2"></i>
                                </div>
                            }

                            <div class="cart-item-info">

                                <h3>
                                    @item.Name
                                </h3>

                                <p>
                                    Bs @item.Price.ToString("N2") por unidad
                                </p>

                            </div>

                            <div class="qty-control">

                                <form asp-action="Decrease"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="productId"
                                           value="@item.ProductId" />

                                    <button class="qty-btn"
                                            type="submit">
                                        −
                                    </button>

                                </form>

                                <strong>
                                    @item.Quantity
                                </strong>

                                <form asp-action="Increase"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="productId"
                                           value="@item.ProductId" />

                                    <button class="qty-btn"
                                            type="submit">
                                        +
                                    </button>

                                </form>

                            </div>

                            <div class="cart-item-total">

                                <strong>
                                    Bs @item.Subtotal.ToString("N2")
                                </strong>

                                <form asp-action="Remove"
                                      method="post"
                                      class="remove-cart-form"
                                      data-product-name="@item.Name">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="productId"
                                           value="@item.ProductId" />

                                    <button class="cart-remove-button"
                                            type="submit">
                                        <i class="bi bi-trash3"></i>
                                        Eliminar
                                    </button>

                                </form>

                            </div>

                        </article>
                    }

                    <div class="cart-clear-container">

                        <form asp-action="Clear"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button class="btn-outline-bakery"
                                    type="submit">
                                Vaciar carrito
                            </button>

                        </form>

                    </div>

                </div>

                <aside class="cart-summary">

                    <h2>
                        Resumen de compra
                    </h2>

                    <div class="cart-summary-row">

                        <span>
                            Subtotal
                        </span>

                        <strong>
                            Bs @total.ToString("N2")
                        </strong>

                    </div>

                    <div class="cart-summary-total">

                        <span>
                            Total
                        </span>

                        <span>
                            Bs @total.ToString("N2")
                        </span>

                    </div>

                    <a asp-controller="Orders"
                       asp-action="Checkout"
                       class="btn-bakery w-100 mt-4">

                        Continuar con la compra

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </aside>

            </div>
        }

    </div>

</div>


<div id="removeModal"
     class="cart-confirm-overlay">

    <div class="cart-confirm-modal">

        <button type="button"
                class="cart-confirm-close"
                id="cancelRemove">
            ×
        </button>

        <div class="cart-confirm-icon">
            <i class="bi bi-cart-x"></i>
        </div>

        <h3>
            ¿Quitar producto?
        </h3>

        <p>
            ¿Quieres quitar
            <strong id="removeProductName"></strong>
            del carrito?
        </p>

        <div class="cart-confirm-actions">

            <button type="button"
                    class="cart-confirm-cancel"
                    id="cancelRemoveButton">
                Cancelar
            </button>

            <button type="button"
                    class="cart-confirm-delete"
                    id="confirmRemoveButton">
                Quitar
            </button>

        </div>

    </div>

</div>


<script>
    document.addEventListener("DOMContentLoaded", function() {

        const modal = document.getElementById("removeModal");
        const productName = document.getElementById("removeProductName");
        const confirmButton = document.getElementById("confirmRemoveButton");
        const cancelButton = document.getElementById("cancelRemoveButton");
        const closeButton = document.getElementById("cancelRemove");

        let selectedForm = null;

        document.querySelectorAll(".remove-cart-form").forEach(function(form) {

            form.addEventListener("submit", function(event) {

                event.preventDefault();

                selectedForm = form;

                productName.textContent =
                    form.getAttribute("data-product-name");

                modal.classList.add("show");

            });

        });

        function closeModal() {

            modal.classList.remove("show");

            selectedForm = null;
        }

        cancelButton.addEventListener("click", closeModal);

        closeButton.addEventListener("click", closeModal);

        modal.addEventListener("click", function(event) {

            if (event.target === modal) {
                closeModal();
            }

        });

        confirmButton.addEventListener("click", function() {

            if (selectedForm) {
                selectedForm.submit();
            }

        });

    });
</script>

<style>
    .cart-confirm-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(74, 52, 38, 0.35);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

        .cart-confirm-overlay.show {
            display: flex;
        }

    .cart-confirm-modal {
        position: relative;
        width: 100%;
        max-width: 390px;
        background: #fffaf4;
        border-radius: 22px;
        padding: 32px 28px 28px;
        text-align: center;
        box-shadow: 0 15px 45px rgba(74, 52, 38, 0.22);
        animation: cartModalAppear 0.2s ease;
    }

    .cart-confirm-close {
        position: absolute;
        top: 12px;
        right: 16px;
        border: none;
        background: transparent;
        color: #8b6a4e;
        font-size: 28px;
        cursor: pointer;
        line-height: 1;
    }

    .cart-confirm-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 16px;
        border-radius: 50%;
        background: #f1e2d2;
        color: #8b6a4e;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }

    .cart-confirm-modal h3 {
        margin: 0 0 10px;
        color: #4a3426;
        font-size: 1.35rem;
        font-weight: 700;
    }

    .cart-confirm-modal p {
        margin: 0 auto 24px;
        color: #806d60;
        font-size: 0.96rem;
        line-height: 1.5;
    }

        .cart-confirm-modal p strong {
            color: #4a3426;
        }

    .cart-confirm-actions {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .cart-confirm-cancel,
    .cart-confirm-delete {
        border: none;
        border-radius: 12px;
        padding: 11px 22px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .cart-confirm-cancel {
        background: #eee3d8;
        color: #5d493b;
    }

        .cart-confirm-cancel:hover {
            background: #e4d5c6;
        }

    .cart-confirm-delete {
        background: #8b6a4e;
        color: #fff;
    }

        .cart-confirm-delete:hover {
            background: #75563f;
        }

    .cart-item-image-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1e2d2;
        color: #8b6a4e;
        font-size: 2rem;
    }

    .cart-clear-container {
        display: flex;
        justify-content: flex-end;
        margin-top: 14px;
    }

    .cart-item-info {
        min-width: 0;
    }

    .cart-item-total {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 8px;
    }

        .cart-item-total > strong {
            color: #4a3426;
        }

    @@keyframes cartModalAppear {
        from {
            opacity: 0;
            transform: scale(0.95);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @@media (max-width: 800px) {

        .cart-item {
            grid-template-columns: 80px 1fr;
        }

        .cart-item-info {
            align-self: center;
        }

        .qty-control {
            grid-column: 2;
        }

        .cart-item-total {
            grid-column: 2;
            align-items: flex-start;
        }
    }

    @@media (max-width: 520px) {

        .cart-confirm-modal {
            max-width: 100%;
            padding: 30px 20px 24px;
        }

        .cart-confirm-actions {
            flex-direction: column;
        }

        .cart-confirm-cancel,
        .cart-confirm-delete {
            width: 100%;
        }

        .cart-item {
            grid-template-columns: 70px 1fr;
        }

        .cart-item-image {
            width: 70px;
            height: 70px;
        }
    }
</style>