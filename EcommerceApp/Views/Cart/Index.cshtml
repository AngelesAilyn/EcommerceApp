@model List<EcommerceApp.Controllers.CartItemViewModel>

@{
    ViewData["Title"] = "Mi carrito";
    decimal total = Model.Sum(item => item.Subtotal);
}

<style>
    .cart-confirm-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(74, 52, 38, 0.35);
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

        .cart-confirm-overlay.show {
            display: flex;
        }

    .cart-confirm-modal {
        position: relative;
        width: 100%;
        max-width: 390px;
        background: #fffaf4;
        border-radius: 22px;
        padding: 32px 28px 28px;
        text-align: center;
        box-shadow: 0 15px 45px rgba(74, 52, 38, 0.22);
        animation: cartModalAppear 0.2s ease;
    }

    .cart-confirm-close {
        position: absolute;
        top: 12px;
        right: 16px;
        border: none;
        background: transparent;
        color: #8b6a4e;
        font-size: 28px;
        cursor: pointer;
        line-height: 1;
    }

    .cart-confirm-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 16px;
        border-radius: 50%;
        background: #f1e2d2;
        color: #8b6a4e;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }

    .cart-confirm-modal h3 {
        margin: 0 0 10px;
        color: #4a3426;
        font-size: 1.35rem;
        font-weight: 700;
    }

    .cart-confirm-modal p {
        margin: 0 auto 24px;
        color: #806d60;
        font-size: 0.96rem;
        line-height: 1.5;
    }

        .cart-confirm-modal p strong {
            color: #4a3426;
        }

    .cart-confirm-actions {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .cart-confirm-cancel,
    .cart-confirm-delete {
        border: none;
        border-radius: 12px;
        padding: 11px 22px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .cart-confirm-cancel {
        background: #eee3d8;
        color: #5d493b;
    }

        .cart-confirm-cancel:hover {
            background: #e4d5c6;
        }

    .cart-confirm-delete {
        background: #8b6a4e;
        color: white;
    }

        .cart-confirm-delete:hover {
            background: #75563f;
        }

    @@keyframes cartModalAppear {
        from {
            opacity: 0;
            transform: scale(0.95);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }</style>
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Mi carrito</h1>
            <p class="text-muted mb-0">Revisa tus productos antes de realizar tu compra.</p>
        </div>

        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-outline-dark">
            Seguir comprando
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <div style="font-size: 4rem;">🛒</div>

            <h2 class="mt-3">Tu carrito está vacío</h2>

            <p class="text-muted">
                Agrega algunos productos de Dulce Antojo para comenzar tu compra.
            </p>

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-dark px-4">
                Ver productos
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">

                @foreach (var item in Model)
                {
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body">
                            <div class="row align-items-center g-3">

                                <div class="col-4 col-md-2">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             alt="@item.Name"
                                             class="img-fluid rounded"
                                             style="width: 100%; height: 100px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                             style="height: 100px;">
                                            <span>🍰</span>
                                        </div>
                                    }
                                </div>

                                <div class="col-8 col-md-4">
                                    <h5 class="fw-bold mb-1">@item.Name</h5>
                                    <p class="text-muted mb-0">
                                        Bs. @item.Price.ToString("0.00")
                                    </p>
                                </div>

                                <div class="col-7 col-md-3">
                                    <div class="d-flex align-items-center gap-2">

                                        <form asp-action="Decrease"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="productId"
                                                   value="@item.ProductId" />

                                            <button type="submit"
                                                    class="btn btn-outline-secondary btn-sm">
                                                −
                                            </button>
                                        </form>

                                        <span class="fw-bold px-2">
                                            @item.Quantity
                                        </span>

                                        <form asp-action="Increase"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="productId"
                                                   value="@item.ProductId" />

                                            <button type="submit"
                                                    class="btn btn-outline-secondary btn-sm">
                                                +
                                            </button>
                                        </form>

                                    </div>
                                </div>

                                <div class="col-5 col-md-2 text-end">
                                    <strong>
                                        Bs. @item.Subtotal.ToString("0.00")
                                    </strong>
                                </div>

                                <div class="col-12 col-md-1 text-end">
                                    <form asp-action="Remove"
                                          method="post"
                                          class="remove-cart-form"
                                          data-product-name="@item.Name">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="productId"
                                               value="@item.ProductId" />

                                        <button type="submit" class="cart-remove-button">
                                            <i class="bi bi-trash3"></i>
                                            Eliminar
                                        </button>

                                    </form>
                                </div>

                            </div>
                        </div>
                    </div>
                }

                <div class="text-end">
                    <form asp-action="Clear"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger btn-sm">
                            Vaciar carrito
                        </button>

                    </form>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">

                        <h4 class="fw-bold mb-4">Resumen de compra</h4>

                        <div class="d-flex justify-content-between mb-3">
                            <span>Subtotal</span>
                            <strong>
                                Bs. @total.ToString("0.00")
                            </strong>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-4">
                            <span class="fw-bold">Total</span>
                            <strong class="fs-4">
                                Bs. @total.ToString("0.00")
                            </strong>
                        </div>

                        <a asp-controller="Orders"
                           asp-action="Checkout"
                           class="btn btn-dark w-100 py-2">
                            Continuar con la compra
                        </a>
                        
                    </div>
                </div>
            </div>
        </div>
    }
</div>
    <div id="removeModal" class="cart-confirm-overlay">

        <div class="cart-confirm-modal">

            <button type="button"
                    class="cart-confirm-close"
                    id="cancelRemove">
                ×
            </button>

            <div class="cart-confirm-icon">
                <i class="bi bi-cart-x"></i>
            </div>

            <h3>¿Quitar producto?</h3>

            <p>
                ¿Quieres quitar
                <strong id="removeProductName"></strong>
                del carrito?
            </p>

            <div class="cart-confirm-actions">

                <button type="button"
                        class="cart-confirm-cancel"
                        id="cancelRemoveButton">
                    Cancelar
                </button>

                <button type="button"
                        class="cart-confirm-delete"
                        id="confirmRemoveButton">
                    Quitar
                </button>

            </div>

        </div>

    </div>
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const modal = document.getElementById("removeModal");
            const productName = document.getElementById("removeProductName");
            const confirmButton = document.getElementById("confirmRemoveButton");
            const cancelButton = document.getElementById("cancelRemoveButton");
            const closeButton = document.getElementById("cancelRemove");

            let selectedForm = null;

            document.querySelectorAll(".remove-cart-form").forEach(function (form) {

                form.addEventListener("submit", function (event) {

                    event.preventDefault();

                    selectedForm = form;

                    productName.textContent =
                        form.getAttribute("data-product-name");

                    modal.classList.add("show");
                });

            });

            function closeModal() {
                modal.classList.remove("show");
                selectedForm = null;
            }

            cancelButton.addEventListener("click", closeModal);

            closeButton.addEventListener("click", closeModal);

            modal.addEventListener("click", function (event) {

                if (event.target === modal) {
                    closeModal();
                }

            });

            confirmButton.addEventListener("click", function () {

                if (selectedForm) {
                    selectedForm.submit();
                }

            });

        });
    </script>