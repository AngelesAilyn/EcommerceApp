@model IEnumerable<EcommerceApp.Models.Inventory>

@{
    ViewData["Title"] = "Inventario";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success text-center rounded-0">@TempData["SuccessMessage"]</div>
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Inventario</h1>
            <p class="text-muted mb-0">Control de existencias de los productos</p>
        </div>
    </div>

    <div class="mb-4">
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index"
               class="btn @(string.IsNullOrEmpty(ViewBag.CategoriaSeleccionada) ? "btn-dark" : "btn-outline-dark")">
                Todos
            </a>

            @foreach (var categoria in ViewBag.Categorias)
            {
                <a asp-action="Index"
                   asp-route-category="@categoria.Name"
                   class="btn @(ViewBag.CategoriaSeleccionada == categoria.Name ? "btn-dark" : "btn-outline-dark")">
                    @categoria.Name
                </a>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h4>No hay registros de inventario</h4>
                    <p class="text-muted mb-0">
                        No existen productos en esta categoría.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Categoría</th>
                                <th>Stock actual</th>
                                <th>Stock mínimo</th>
                                <th>Estado</th>
                                <th>Última actualización</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @item.Product?.Name
                                    </td>

                                    <td>
                                        @item.Product?.CategoryNavigation?.Name
                                    </td>

                                    <td>
                                        @item.CurrentQuantity
                                    </td>

                                    <td>
                                        @item.MinimumStock
                                    </td>

                                    <td>
                                        @if (item.StockStatus == "Agotado")
                                        {
                                            <span class="badge bg-danger">
                                                Agotado
                                            </span>
                                        }
                                        else if (item.StockStatus == "Stock bajo")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Stock bajo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Disponible
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @item.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-dark">
                                            Editar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>