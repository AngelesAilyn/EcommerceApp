<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp"
ReportInfo.Created="09/22/2026 00:00:00"
ReportInfo.Modified="09/22/2026 00:00:00">

	<Dictionary>
		<TableDataSource Name="Pedidos"
		   ReferenceName="PedidosData.Pedidos"
		   TableName="Pedidos"
		   DataType="System.Int32"
		   Enabled="true">

			<Column Name="Pedido" DataType="System.String"/>
			<Column Name="Fecha" DataType="System.String"/>
			<Column Name="Cliente" DataType="System.String"/>
			<Column Name="Total" DataType="System.Decimal"/>
			<Column Name="MetodoPago" DataType="System.String"/>
			<Column Name="EstadoPago" DataType="System.String"/>
			<Column Name="Entrega" DataType="System.String"/>
			<Column Name="EstadoPedido" DataType="System.String"/>

		</TableDataSource>

	</Dictionary>
	<ReportPage Name="Page1"
Landscape="true"
PaperWidth="297"
PaperHeight="210"
LeftMargin="8"
RightMargin="8"
TopMargin="8"
BottomMargin="8">

